---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactSection from "../components/sections/ContactSection.astro";
import FAQSection from "../components/sections/FAQSection.astro";
---

<BaseLayout
  title="Contacto | Agenda una Asesoría Gratuita"
  description="Ponte en contacto con Novory Studio. Agenda una asesoría tecnológica gratuita y resuelve tus dudas con nuestro equipo."
>
  <div>
    <!-- Formulario de Contacto -->
    <ContactSection />

    <!-- Preguntas Frecuentes (FAQ) -->
    <FAQSection />
  </div>
</BaseLayout>

<style is:global>
  /* Alinear la primera sección del contacto con el espaciado estándar del sitio (112px/128px) */
  #contacto {
    padding-top: 112px !important;
  }
  #contacto .py-10 {
    padding-top: 0 !important;
  }
  @media (min-width: 768px) {
    #contacto {
      padding-top: 128px !important;
    }
  }
</style>
