---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/atoms/Button.astro';
import { ArrowLeft, Compass } from '@lucide/astro';
import { withBase } from '../utils/navigation';
---

<BaseLayout title="Página no encontrada" hideSuffix={false}>
  <div class="min-h-[80vh] flex items-center justify-center relative overflow-hidden py-24 px-6">
    <!-- Glowing background elements -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-brand-cyan/20 dark:bg-brand-blue/15 blur-[140px] rounded-full pointer-events-none"></div>
    <div class="absolute top-1/3 left-1/3 w-64 h-64 bg-brand-purple/15 blur-[100px] rounded-full pointer-events-none"></div>

    <div class="relative z-10 max-w-xl w-full text-center flex flex-col items-center">
      <!-- 404 Visual Pill -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand-cyan/10 dark:bg-brand-blue/15 border border-brand-cyan/20 dark:border-brand-blue/30 text-brand-blue dark:text-brand-cyan text-sm font-semibold mb-6">
        <Compass class="w-4 h-4 animate-spin-slow" />
        <span>Error 404</span>
      </div>

      <!-- Large 404 Number -->
      <h1 class="text-7xl sm:text-9xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-brand-cyan via-brand-blue to-brand-purple mb-4">
        404
      </h1>

      <!-- Title & Subtitle -->
      <h2 class="text-2xl sm:text-3xl font-bold text-text-dark-titles dark:text-white mb-4">
        Página fuera de alcance
      </h2>
      
      <p class="text-base sm:text-lg text-text-dark dark:text-text-light mb-8 max-w-md leading-relaxed">
        La ruta que intentas acceder no existe, cambió de lugar o nunca existió. Te ayudamos a volver al camino correcto.
      </p>

      <!-- Action Button -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center w-full sm:w-auto">
        <Button href={withBase('/')} variant="primary" iconPosition="left">
          <ArrowLeft slot="icon" class="w-5 h-5" />
          Volver al Inicio
        </Button>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .animate-spin-slow {
    animation: spin-slow 12s linear infinite;
  }
</style>
