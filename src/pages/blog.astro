---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/layout/Section.astro';
import Card from '../components/molecules/Card.astro';
import { Calendar, User } from '@lucide/astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formatDate = (date: Date) => date.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title="Blog de Tecnología y Negocios Locales">
  <Section class="pt-40 pb-32 relative overflow-hidden">
    <!-- Background glow -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-accent/[0.03] blur-[120px] rounded-full -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>

    <div class="flex flex-col gap-8 mb-24 section-header relative z-10">
       <div class="flex items-center gap-3">
         <div class="w-10 h-[2px] bg-accent"></div>
         <span class="text-accent font-black text-xs md:text-sm tracking-[0.4em] uppercase">Conocimiento</span>
      </div>
      <h1 class="text-white text-6xl md:text-9xl font-bold tracking-tighter leading-[0.9] max-w-4xl">Ideas que <br /> Impulsan.</h1>
      <p class="text-text-secondary text-xl md:text-2xl max-w-3xl leading-relaxed font-light">
        Compartimos estrategias sobre SEO, automatización y desarrollo web diseñadas para ayudar a los negocios locales a dominar su mercado digital.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 blog-grid relative z-10">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}`} class="group h-full">
          <Card class="h-full flex flex-col gap-10 p-10 bg-white/[0.01] border-white/5 group-hover:border-accent/30 group-hover:bg-white/[0.02] transition-all duration-500 rounded-[32px]">
            <div class="flex flex-col gap-5">
              <div class="flex items-center gap-4 text-[10px] text-text-secondary font-black uppercase tracking-[0.2em]">
                <div class="flex items-center gap-1.5">
                  <Calendar class="w-3.5 h-3.5 text-accent" />
                  <span>{formatDate(post.data.pubDate)}</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <User class="w-3.5 h-3.5 text-accent" />
                  <span>{post.data.author}</span>
                </div>
              </div>
              <h2 class="text-2xl font-bold text-white group-hover:text-accent transition-colors duration-300 leading-snug tracking-tight">
                {post.data.title}
              </h2>
            </div>
            <p class="text-text-secondary text-base leading-relaxed line-clamp-3">
              {post.data.description}
            </p>
            <div class="mt-auto pt-6 border-t border-white/5 flex items-center justify-between">
              <span class="text-accent font-black text-xs tracking-[0.3em] uppercase">Leer Más</span>
              <div class="w-10 h-10 rounded-full border border-white/5 flex items-center justify-center group-hover:border-accent/30 group-hover:bg-accent/10 transition-all duration-500">
                 <span class="group-hover:translate-x-1 transition-transform duration-300">→</span>
              </div>
            </div>
          </Card>
        </a>
      ))}
    </div>
  </Section>
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initBlog() {
    gsap.from('.section-header > *', {
       opacity: 0,
       y: 40,
       stagger: 0.15,
       duration: 1,
       ease: 'power4.out'
    });

    gsap.from('.blog-grid > a', {
      scrollTrigger: {
        trigger: '.blog-grid',
        start: 'top 85%',
      },
      opacity: 0,
      y: 40,
      stagger: 0.1,
      duration: 1,
      ease: 'power4.out',
    });
  }

  window.addEventListener('load', initBlog);
  document.addEventListener('astro:page-load', initBlog);
</script>
