---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/layout/Section.astro';
import Card from '../components/molecules/Card.astro';
import { Calendar, User } from '@lucide/astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formatDate = (date: Date) => date.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title="Blog de Tecnología y Negocios Locales | Novory">
  <Section class="pt-32 md:pt-40 pb-20 md:pb-32 bg-light-base dark:bg-dark-base relative overflow-hidden transition-colors duration-500">
    
    <!-- Background glow -->
    <div class="absolute top-0 right-0 w-75 md:w-125 h-75 md:h-125 bg-brand-cyan/20 dark:bg-brand-blue/10 blur-[120px] md:blur-[150px] rounded-full -translate-y-1/2 translate-x-1/2 pointer-events-none transition-colors duration-700"></div>

    <div class="flex flex-col gap-6 md:gap-8 mb-16 md:mb-24 section-header relative z-10 px-4 md:px-0">
       <div class="flex items-center gap-3">
         <div class="w-8 md:w-10 h-0.5 bg-brand-blue dark:bg-brand-cyan transition-colors"></div>
         <span class="text-brand-blue dark:text-brand-cyan font-black text-xs md:text-sm tracking-[0.3em] md:tracking-[0.4em] uppercase transition-colors">Conocimiento</span>
      </div>
      <h1 class="text-text-dark-titles dark:text-white text-5xl md:text-7xl lg:text-9xl font-bold tracking-tighter leading-none md:leading-[0.9] max-w-4xl transition-colors">
        Ideas que <br /> <span class="bg-clip-text text-transparent bg-linear-to-r from-brand-cyan via-brand-blue to-brand-purple">Impulsan.</span>
      </h1>
      <p class="text-text-dark dark:text-text-secondary text-lg md:text-xl lg:text-2xl max-w-3xl leading-relaxed font-medium md:font-light transition-colors mt-2 md:mt-4">
        Compartimos estrategias sobre SEO, automatización y desarrollo web diseñadas para ayudar a los negocios locales a dominar su mercado digital.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 blog-grid relative z-10 px-4 md:px-0">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}`} class="group h-full outline-none">
          <Card class="h-full flex flex-col gap-8 md:gap-10 p-8 md:p-10 bg-light-surface/40 dark:bg-white/2 border-light-border/50 dark:border-white/5 group-hover:border-brand-blue/40 dark:group-hover:border-brand-cyan/40 group-hover:bg-light-surface dark:group-hover:bg-white/5 transition-all duration-500 rounded-4xl">
            <div class="flex flex-col gap-4 md:gap-5">
              <div class="flex flex-wrap items-center gap-3 md:gap-4 text-[10px] md:text-[11px] text-text-dark dark:text-text-secondary font-black uppercase tracking-[0.2em] transition-colors">
                <div class="flex items-center gap-1.5">
                  <Calendar class="w-3.5 h-3.5 md:w-4 md:h-4 text-brand-blue dark:text-brand-cyan transition-colors" />
                  <span>{formatDate(post.data.pubDate)}</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <User class="w-3.5 h-3.5 md:w-4 md:h-4 text-brand-blue dark:text-brand-cyan transition-colors" />
                  <span>{post.data.author}</span>
                </div>
              </div>
              <h2 class="text-xl md:text-2xl font-bold text-text-dark-titles dark:text-white group-hover:text-brand-blue dark:group-hover:text-brand-cyan transition-colors duration-300 leading-snug tracking-tight">
                {post.data.title}
              </h2>
            </div>
            <p class="text-text-dark dark:text-text-secondary text-sm md:text-base leading-relaxed line-clamp-3 transition-colors">
              {post.data.description}
            </p>
            <div class="mt-auto pt-6 border-t border-light-border/40 dark:border-white/5 flex items-center justify-between transition-colors">
              <span class="text-brand-blue dark:text-brand-cyan font-black text-[10px] md:text-xs tracking-[0.2em] md:tracking-[0.3em] uppercase transition-colors">Leer Más</span>
              <div class="w-10 h-10 rounded-full border border-light-border dark:border-white/5 flex items-center justify-center group-hover:border-brand-blue/30 dark:group-hover:border-brand-cyan/30 group-hover:bg-brand-blue/10 dark:group-hover:bg-brand-cyan/10 transition-all duration-500 bg-light-base dark:bg-transparent">
                 <span class="text-text-dark-titles dark:text-white group-hover:text-brand-blue dark:group-hover:text-brand-cyan group-hover:translate-x-1 transition-all duration-300">→</span>
              </div>
            </div>
          </Card>
        </a>
      ))}
    </div>
  </Section>
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initBlog() {
    gsap.from('.section-header > *', {
       opacity: 0,
       y: 40,
       stagger: 0.15,
       duration: 1,
       ease: 'power4.out'
    });

    gsap.from('.blog-grid > a', {
      scrollTrigger: {
        trigger: '.blog-grid',
        start: 'top 85%',
      },
      opacity: 0,
      y: 40,
      stagger: 0.1,
      duration: 1,
      ease: 'power4.out',
    });
  }

  window.addEventListener('load', initBlog);
  document.addEventListener('astro:page-load', initBlog);
</script>
