---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const cases = await getCollection('case-studies');
  return cases.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title}>
  <article class="pt-40 pb-32 container-novory relative overflow-hidden">
    <!-- Background glow -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-accent/5 blur-[120px] rounded-full -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>

    <div class="max-w-4xl mx-auto flex flex-col gap-16 relative z-10">
      <div class="flex flex-col gap-8">
        <a href="/portafolio" class="text-accent font-bold hover:underline underline-offset-4 decoration-2">← Volver al portafolio</a>
        <h1 class="text-white text-5xl md:text-8xl font-bold tracking-tighter leading-[0.95]">{entry.data.title}</h1>
        <div class="flex flex-wrap gap-4">
          {entry.data.technologies.map((tech) => (
            <span class="px-5 py-2 rounded-full bg-white/5 border border-white/10 text-white/70 text-xs font-black uppercase tracking-[0.2em]">{tech}</span>
          ))}
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 py-12 border-y border-white/5">
        <div class="flex flex-col gap-2">
           <span class="text-[10px] text-text-secondary uppercase font-black tracking-[0.3em]">Negocio</span>
           <p class="text-2xl text-white font-bold tracking-tight">{entry.data.businessName}</p>
        </div>
        <div class="flex flex-col gap-2">
           <span class="text-[10px] text-text-secondary uppercase font-black tracking-[0.3em]">Resultado Clave</span>
           <p class="text-2xl text-accent font-bold tracking-tight">{entry.data.result}</p>
        </div>
        <div class="flex flex-col gap-2">
           <span class="text-[10px] text-text-secondary uppercase font-black tracking-[0.3em]">Proyecto</span>
           <p class="text-2xl text-white font-bold tracking-tight">Digitalización 360°</p>
        </div>
      </div>

      <div class="prose prose-invert prose-xl max-w-none prose-headings:text-white prose-p:text-text-secondary prose-strong:text-white prose-p:leading-relaxed">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
