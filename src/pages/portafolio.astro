---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PortfolioProject from "../components/molecules/PortfolioProject.astro";
import Section from "../components/layout/Section.astro";

const projects = await getCollection("case-studies");
---

<BaseLayout title="Portafolio de Transformación Digital | Novory">
  <Section
    class="portfolio-page-container pt-32 md:pt-40 pb-20 bg-light-base dark:bg-dark-base transition-colors duration-500 overflow-hidden relative"
  >
    <!-- Resplandor de fondo premium -->
    <div
      class="absolute top-0 right-0 w-100 md:w-150 h-100 md:h-150 bg-brand-cyan/15 dark:bg-brand-blue/10 blur-[150px] md:blur-[200px] rounded-full -translate-y-1/2 translate-x-1/2 pointer-events-none transition-colors duration-700"
    >
    </div>

    <div
      class="flex flex-col gap-6 md:gap-8 mb-20 md:mb-24 section-header relative z-10 px-4 md:px-0"
    >
      <div class="flex items-center gap-3">
        <div
          class="w-8 md:w-10 h-0.5 bg-brand-blue dark:bg-brand-cyan transition-colors"
        >
        </div>
        <span
          class="text-brand-blue dark:text-brand-cyan font-black text-xs md:text-sm tracking-[0.3em] md:tracking-[0.4em] uppercase transition-colors"
          >Nuestro Trabajo</span
        >
      </div>
      <h1
        class="text-text-dark-titles dark:text-white text-5xl md:text-7xl lg:text-8xl font-bold tracking-tighter leading-none md:leading-[0.9] max-w-4xl transition-colors"
      >
        Transformaciones <br />
        <span
          class="bg-clip-text text-transparent bg-linear-to-r from-brand-cyan via-brand-blue to-brand-purple"
          >Reales.</span
        >
      </h1>
      <p
        class="text-text-dark dark:text-text-secondary text-lg md:text-xl lg:text-2xl max-w-3xl leading-relaxed font-medium md:font-light transition-colors mt-4"
      >
        No coleccionamos sitios web, coleccionamos historias de éxito. Cada
        proyecto es una prueba de nuestro compromiso con el crecimiento real de
        nuestros clientes.
      </p>
    </div>

    <div class="flex flex-col gap-12 md:gap-0">
      {
        projects.map((project, index) => (
          <PortfolioProject
            title={project.data.title}
            problem={project.data.problem}
            solution={project.data.solution}
            result={project.data.result}
            technologies={project.data.technologies}
            href={`/casos/${project.slug}`}
            side={index % 2 === 0 ? "right" : "left"}
          />
        ))
      }
    </div>
  </Section>
</BaseLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let ctx: gsap.Context | null = null;

  function initPortfolioPage() {
    const container = document.querySelector(".portfolio-page-container");
    if (!container) return;

    ctx = gsap.context(() => {
      gsap.from(".section-header > *", {
        opacity: 0,
        y: 40,
        stagger: 0.15,
        duration: 1.2,
        ease: "power4.out",
      });

      gsap.utils.toArray(".portfolio-reveal").forEach((project: any) => {
        gsap.fromTo(
          project,
          { y: 64, opacity: 0 },
          {
            scrollTrigger: {
              trigger: project,
              start: "top 85%",
            },
            opacity: 1,
            y: 0,
            duration: 1.2,
            ease: "power4.out",
          },
        );
      });
    }, container);
  }

  document.addEventListener("astro:page-load", initPortfolioPage);
  document.addEventListener("astro:before-swap", () => {
    if (ctx) {
      ctx.revert();
      ctx = null;
    }
  });
</script>
