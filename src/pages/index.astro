---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import BusinessSection from '../components/sections/BusinessSection.astro';
import ProblemsSection from '../components/sections/ProblemsSection.astro';
import ServicesSection from '../components/sections/ServicesSection.astro';
import ProcessSection from '../components/sections/ProcessSection.astro';
import DemosSection from '../components/sections/DemosSection.astro';
import BenefitsSection from '../components/sections/BenefitsSection.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import FAQSection from '../components/sections/FAQSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
---

<BaseLayout 
  title="Novory Studio | Agencia de Automatizaciones con IA y Desarrollo Web"
  description="Transformamos negocios locales con IA y desarrollo web. Implementamos chatbots 24/7, agentes de voz, agendamiento automático y SEO local para escalar tus ventas. ¡Agenda tu asesoría!"
  canonical="https://novorystudio.com/"
  ogUrl="https://novorystudio.com/"
  ogImage="https://novorystudio.com/assets/novory-logotipo-horizontal-color-dark-og.png"
  hideSuffix={true}
>
  <div id="inicio"><HeroSection /></div>
  <BusinessSection />
  <ProblemsSection />
  <div id="servicios"><ServicesSection /></div>
  <DemosSection />
  <ProcessSection />
  <BenefitsSection />
  <div id="nosotros"><AboutSection /></div>
  <FAQSection />
  <div id="contacto"><ContactSection /></div>
</BaseLayout>
