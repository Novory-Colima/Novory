---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import BusinessSection from '../components/sections/BusinessSection.astro';
import ProblemsSection from '../components/sections/ProblemsSection.astro';
import ServicesTeaserSection from '../components/sections/ServicesTeaserSection.astro';
import DemosSection from '../components/sections/DemosSection.astro';
import GlobalCTA from '../components/GlobalCTA.astro';
---

<BaseLayout 
  title="Novory Studio | Agencia de Automatizaciones con IA y Desarrollo Web"
  description="Transformamos negocios locales con IA y desarrollo web. Implementamos chatbots 24/7, agentes de voz, agendamiento automático y SEO local para escalar tus ventas. ¡Agenda tu asesoría!"
  canonical="https://novorystudio.com/"
  ogUrl="https://novorystudio.com/"
  ogImage="https://novorystudio.com/assets/novory-logotipo-horizontal-color-dark-og.png"
  hideSuffix={true}
>
  <div id="inicio"><HeroSection /></div>
  <BusinessSection />
  <ProblemsSection />
  <div id="servicios"><ServicesTeaserSection /></div>
  <DemosSection />
  <GlobalCTA 
    titulo="¿Y si el próximo caso de éxito digital es tu negocio?"
    subtitulo="Creamos ecosistemas web diseñados para captar la atención, transmitir confianza y automatizar tus ventas."
    textoBoton1="Quiero un proyecto así →"
    linkBoton1="/contacto"
    textoBoton2="Hablemos"
    linkBoton2="https://wa.me/523121992198?text=Hola%20Novory%2C%20visit%C3%A9%20su%20p%C3%A1gina%20y%20me%20interesa%20saber%20c%C3%B3mo%20pueden%20ayudar%20a%20mi%20negocio."
  />
</BaseLayout>
