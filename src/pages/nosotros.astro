---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/layout/Section.astro';
import ProcessSection from '../components/sections/ProcessSection.astro';
import GlobalCTA from '../components/GlobalCTA.astro';
import { withBase } from '../utils/navigation';
import { Users, Target, Code2, Cpu, Sparkles, Terminal } from '@lucide/astro';

const values = [
  {
    icon: Users,
    title: 'Cercanía y Capacidad',
    description: 'No somos una corporación distante. Somos un equipo apasionado, con la frescura de los nativos digitales y obsesionado con la excelencia técnica.'
  },
  {
    icon: Target,
    title: 'Resultados Reales',
    description: 'Dejamos las métricas vanidosas a un lado. Construimos activos digitales pensados para conversiones, ventas y optimización operativa.'
  },
  {
    icon: Code2,
    title: 'Calidad Extrema (Sin Plantillas)',
    description: 'Desarrollamos a nivel de código. Esto garantiza que tu plataforma sea ultrarrápida, escalable y esté optimizada para el algoritmo de Google desde el día uno.'
  },
  {
    icon: Cpu,
    title: 'Innovación Continua',
    description: 'Mientras otras agencias apenas descubren la Inteligencia Artificial, en Novory Studio es nuestro lenguaje nativo. Tu ecosistema digital siempre estará un paso adelante.'
  }
];
---

<BaseLayout 
  title="Nosotros | Nuestra Filosofía y Perspectiva de Ingeniería"
  description="Conoce Novory Studio. Un equipo apasionado por la ingeniería, inteligencia artificial y desarrollo web de alto nivel para negocios locales."
>
  <div>
    <!-- Hero / Nuestra Misión -->
    <Section class="bg-light-base dark:bg-dark-base relative overflow-hidden transition-colors duration-500 pt-28 md:pt-32 pb-12 md:pb-20">
      <!-- Background glow -->
      <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-brand-cyan/10 dark:bg-brand-blue/10 blur-[130px] rounded-full pointer-events-none transition-colors"></div>
      <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-brand-blue/10 dark:bg-brand-cyan/5 blur-[120px] rounded-full pointer-events-none transition-colors"></div>

      <div class="relative z-10">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 rounded-xl bg-brand-blue/10 flex items-center justify-center text-brand-blue dark:text-brand-cyan transition-colors">
            <Sparkles class="w-5 h-5" />
          </div>
          <span class="text-brand-blue dark:text-brand-cyan font-black text-xs md:text-sm tracking-[0.3em] uppercase transition-colors">
            Nuestra Misión
          </span>
        </div>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-text-dark-titles dark:text-text-light-titles tracking-tighter leading-[1.1] mb-8 transition-colors">
          <span class="bg-clip-text text-transparent bg-linear-to-r from-brand-cyan via-brand-blue to-brand-purple">Tecnología de Alto Nivel</span> para Negocios Locales
        </h1>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12 items-start">
          <div class="lg:col-span-7 flex flex-col gap-6 text-text-dark dark:text-text-light text-lg leading-relaxed font-medium md:font-light transition-colors">
            <p>
              Durante años vimos cómo muchos negocios locales tenían productos y servicios de excelencia, pero su presencia digital no reflejaba esa misma calidad.
            </p>
            <p>
              Muchos se mantienen atados a procesos de tareas manuales, dependiendo exclusivamente de redes sociales volátiles o comprando sitios web genéricos que no generan ni un solo cliente.
            </p>
            <p>
              <strong class="text-brand-blue dark:text-brand-cyan font-bold">Novory Studio nació para cerrar esa brecha.</strong> Creemos que la tecnología avanzada y la Inteligencia Artificial no deben ser un lujo, sino la herramienta principal para que los negocios locales prosperen, ahorren tiempo y compitan como gigantes.
            </p>
          </div>

          <!-- Quote Box / Manifiesto -->
          <div class="lg:col-span-5">
            <blockquote class="nosotros-interactive-card p-8 rounded-2xl bg-light-surface/60 dark:bg-white/4 border-l-4 border-brand-blue dark:border-brand-cyan border-y border-r border-light-border/40 dark:border-white/10 backdrop-blur-md shadow-lg transition-colors cursor-pointer select-none">
              <div class="relative z-10">
                <p class="text-text-dark-titles dark:text-white font-medium italic text-xl md:text-2xl leading-relaxed mb-4">
                  “Desarrollamos tecnología que impulsa la productividad, optimiza el tiempo y abre camino a nuevas oportunidades.”
                </p>
                <footer class="text-xs uppercase tracking-widest font-bold text-brand-blue dark:text-brand-cyan">
                  — Manifiesto Novory Studio
                </footer>
              </div>
            </blockquote>
          </div>
        </div>
      </div>
    </Section>

    <!-- Nuestro ADN: Perspectiva de Ingeniería -->
    <Section class="bg-light-surface/30 dark:bg-dark-surface relative overflow-hidden transition-colors duration-500 py-16 md:py-24 border-y border-light-border/40 dark:border-white/5">
      <div class="relative z-10">
        <div class="max-w-3xl mb-12">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-brand-blue/10 flex items-center justify-center text-brand-blue dark:text-brand-cyan">
              <Terminal class="w-4 h-4" />
            </div>
            <span class="text-brand-blue dark:text-brand-cyan font-black text-xs md:text-sm tracking-[0.3em] uppercase">
              Formación y Enfoque Técnico
            </span>
          </div>

          <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-text-dark-titles dark:text-white tracking-tight leading-tight mb-6">
            Nuestro ADN: Una Perspectiva de Ingeniería
          </h2>

          <div class="flex flex-col gap-6 text-text-dark dark:text-text-secondary text-base md:text-lg leading-relaxed">
            <p>
              No somos una agencia tradicional. Nuestro núcleo está fundamentado en la ingeniería y el análisis de sistemas. Con formación técnica avanzada en <strong class="text-text-dark-titles dark:text-white font-semibold">Computación Inteligente</strong> y <strong class="text-text-dark-titles dark:text-white font-semibold">Mecatrónica</strong>, no nos limitamos a hacer "diseños bonitos".
            </p>
            <p>
              Nosotros analizamos tu negocio como un sistema integral. Diseñamos plataformas web con arquitecturas robustas y desarrollamos automatizaciones lógicas que resuelven cuellos de botella reales. Para nosotros, cada línea de código y cada agente de IA implementado debe tener un propósito medible: <strong class="text-brand-blue dark:text-brand-cyan font-semibold">hacerte ganar más dinero y recuperar tu tiempo.</strong>
            </p>
          </div>
        </div>
      </div>
    </Section>

    <!-- ¿Por qué elegirnos? (Valores) -->
    <Section class="bg-light-base dark:bg-dark-base relative overflow-hidden transition-colors duration-500 py-16 md:py-24">
      <div class="relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
          <span class="text-brand-blue dark:text-brand-cyan font-black text-xs md:text-sm tracking-[0.3em] uppercase block mb-3">
            Nuestros Valores
          </span>
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-text-dark-titles dark:text-white tracking-tight mb-4">
            ¿Por qué elegirnos?
          </h2>
          <p class="text-text-dark dark:text-text-secondary text-base md:text-lg">
            Los pilares fundamentales que guían cada uno de nuestros desarrollos y relaciones con clientes.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
          {values.map((item) => (
            <div class="nosotros-interactive-card group p-8 rounded-2xl bg-light-surface/40 dark:bg-white/3 border border-light-border/40 dark:border-white/10 hover:border-brand-blue/40 dark:hover:border-brand-cyan/40 hover:bg-light-surface dark:hover:bg-white/6 hover:-translate-y-1.5 transition-all duration-300 shadow-sm hover:shadow-xl flex flex-col gap-4 cursor-pointer select-none">
              <div class="relative z-10 flex flex-col gap-4">
                <div class="w-12 h-12 rounded-xl bg-brand-blue/10 dark:bg-brand-cyan/10 flex items-center justify-center text-brand-blue dark:text-brand-cyan group-hover:scale-110 transition-transform duration-300">
                  <item.icon class="w-6 h-6" />
                </div>
                <h3 class="text-xl md:text-2xl font-bold text-text-dark-titles dark:text-white tracking-tight group-hover:text-brand-blue dark:group-hover:text-brand-cyan transition-colors">
                  {item.title}
                </h3>
                <p class="text-text-dark dark:text-text-secondary text-base leading-relaxed">
                  {item.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </Section>

    <!-- Process Section -->
    <ProcessSection />

    <!-- Pre-Footer Global CTA -->
    <div class="mt-8 md:mt-16">
      <GlobalCTA 
        titulo="Eleva el nivel tecnológico de tu empresa."
        subtitulo="Únete a los negocios locales que están escalando gracias a una verdadera perspectiva de ingeniería."
        textoBoton1="Iniciar un Proyecto →"
        linkBoton1={withBase('/contacto')}
        textoBoton2="Contactar al Equipo"
        linkBoton2="https://wa.me/523121992198?text=Hola%20Novory%2C%20me%20gust%C3%B3%20mucho%20su%20enfoque%20t%C3%A9cnico%20y%20me%20gustar%C3%ADa%20platicar%20sobre%20un%20proyecto."
      />
    </div>
  </div>
</BaseLayout>

<style>
  .nosotros-interactive-card {
    position: relative;
    overflow: hidden;
    transition: border-color 0.4s, background-color 0.4s, box-shadow 0.4s;
  }

  /* Spotlight / Lighting hover effect overlay */
  .nosotros-interactive-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
    background: radial-gradient(
      300px circle at var(--mouse-x, -999px) var(--mouse-y, -999px),
      rgba(68, 102, 255, 0.08),
      transparent 80%
    );
  }

  :global(.dark) .nosotros-interactive-card::before {
    background: radial-gradient(
      350px circle at var(--mouse-x, -999px) var(--mouse-y, -999px),
      rgba(68, 162, 255, 0.12),
      rgba(86, 63, 191, 0.06) 50%,
      transparent 80%
    );
  }

  .nosotros-interactive-card:hover::before {
    opacity: 1;
  }
</style>

<script>
  import { gsap } from "gsap";

  function initNosotrosInteractions() {
    const cards = document.querySelectorAll(".nosotros-interactive-card");

    cards.forEach((card) => {
      const htmlCard = card as HTMLElement;

      const onMouseMove = (e: MouseEvent) => {
        const rect = htmlCard.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        // Set spotlight positions
        htmlCard.style.setProperty("--mouse-x", `${x}px`);
        htmlCard.style.setProperty("--mouse-y", `${y}px`);

        // Magnetic Effect
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;
        const deltaX = e.clientX - centerX;
        const deltaY = e.clientY - centerY;

        // Magnet range factor (max displacement 12px)
        const targetX = (deltaX / rect.width) * 12;
        const targetY = (deltaY / rect.height) * 12;

        gsap.to(htmlCard, {
          x: targetX,
          y: targetY,
          duration: 0.35,
          ease: "power2.out",
          overwrite: "auto",
        });
      };

      const onMouseLeave = () => {
        // Reset spotlight positions
        htmlCard.style.setProperty("--mouse-x", "-999px");
        htmlCard.style.setProperty("--mouse-y", "-999px");

        // Reset magnetic position smoothly
        gsap.to(htmlCard, {
          x: 0,
          y: 0,
          duration: 0.6,
          ease: "elastic.out(1.1, 0.6)",
          overwrite: "auto",
        });
      };

      htmlCard.addEventListener("mousemove", onMouseMove);
      htmlCard.addEventListener("mouseleave", onMouseLeave);
    });
  }

  document.addEventListener("astro:page-load", initNosotrosInteractions);
</script>
