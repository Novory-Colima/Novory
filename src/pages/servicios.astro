---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

// Demos Images
import imgMapache1 from '../assets/demos/mapache-1.webp';
import imgMapache2 from '../assets/demos/mapache-2.webp';
import imgMapache3 from '../assets/demos/mapache-3.webp';

import imgNebula1 from '../assets/demos/nebula-1.webp';
import imgNebula2 from '../assets/demos/nebula-2.webp';
import imgNebula3 from '../assets/demos/nebula-3.webp';

import imgWyw1 from '../assets/demos/wyw-1.webp';
import imgWyw2 from '../assets/demos/wyw-2.webp';
import imgWyw3 from '../assets/demos/wyw-3.webp';

const webProjects = [
  {
    id: "mapache",
    title: "Mapache Fashion",
    description: "Marca de moda premium, contemporánea, elegante y sofisticada con un estilo minimalista.",
    link: "https://mapache.novorystudio.com",
    images: [imgMapache1, imgMapache2, imgMapache3]
  },
  {
    id: "nebula",
    title: "Nebula Glitch Social Club",
    description: "Cafetería de especialidad donde el café es el protagonista y la tecnología amplifica la experiencia.",
    link: "https://nebula.novorystudio.com",
    images: [imgNebula1, imgNebula2, imgNebula3]
  },
  {
    id: "wander",
    title: "Wander & Wonder",
    description: "Experiencia web cinematográfica e inmersiva para convertir visitantes en clientes de una agencia de viajes.",
    link: "https://wander.novorystudio.com",
    images: [imgWyw1, imgWyw2, imgWyw3]
  }
];
---

<BaseLayout 
  title="Servicios | Soluciones Digitales Inteligentes"
  description="Tecnología de alto nivel, diseñada para hacer crecer tu negocio. Desarrollo web optimizado y automatizaciones con IA."
>
  <section class="relative w-full overflow-hidden bg-light-surface dark:bg-dark-base pt-32 pb-20 md:pt-40 md:pb-28">
    <!-- Efecto de gradiente y glow estilo neón sutil -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden mix-blend-multiply dark:mix-blend-screen opacity-50 dark:opacity-100">
      <!-- Glow central -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] sm:w-[800px] sm:h-[500px] bg-brand-blue/15 blur-[100px] rounded-full"></div>
      <!-- Glow superior derecho cyan -->
      <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-brand-cyan/20 dark:bg-brand-cyan/10 blur-[90px] rounded-full translate-x-1/4 -translate-y-1/4"></div>
      <!-- Glow inferior izquierdo purple -->
      <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-brand-purple/20 dark:bg-brand-purple/15 blur-[120px] rounded-full -translate-x-1/4 translate-y-1/4"></div>
    </div>
    
    <div class="container-novory relative z-10 text-center flex flex-col items-center justify-center min-h-[50vh]">
      
      <!-- Badge de pre-título -->
      <div class="mb-6 inline-flex items-center gap-2 px-4 py-2 rounded-full border border-brand-blue/20 dark:border-brand-cyan/30 bg-brand-blue/5 dark:bg-brand-cyan/5 text-brand-blue dark:text-brand-cyan text-sm sm:text-base font-medium backdrop-blur-md shadow-[0_0_15px_rgba(68,102,255,0.1)] dark:shadow-[0_0_20px_rgba(68,162,255,0.15)]">
        <span class="relative flex w-2.5 h-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-blue dark:bg-brand-cyan opacity-75"></span>
          <span class="relative inline-flex rounded-full w-2.5 h-2.5 bg-brand-blue dark:bg-brand-cyan"></span>
        </span>
        Innovación Digital
      </div>
      
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-text-dark-titles dark:text-white mb-6 max-w-4xl tracking-tight leading-tight drop-shadow-sm dark:drop-shadow-lg">
        Tecnología de alto nivel, diseñada para <br class="hidden lg:block"/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-blue via-brand-purple to-brand-cyan dark:from-brand-cyan dark:via-brand-blue dark:to-brand-purple drop-shadow-none">hacer crecer tu negocio.</span>
      </h1>
      
      <p class="text-lg sm:text-xl text-text-dark dark:text-text-secondary max-w-3xl mx-auto mb-0 leading-relaxed font-light">
        Combinamos <strong class="text-text-dark-titles dark:text-white font-medium">desarrollo web de ultra rendimiento</strong> con <strong class="text-text-dark-titles dark:text-white font-medium">automatizaciones de Inteligencia Artificial</strong> para optimizar tus procesos operativos, multiplicar tus leads y <strong class="text-text-dark-titles dark:text-white font-medium">escalar tus ventas 24/7</strong>.
      </p>
    </div>
  </section>

  <!-- Sección: Desarrollo Web de Alto Rendimiento -->
  <section class="py-20 md:py-32 bg-light-base dark:bg-dark-base transition-colors duration-500 overflow-hidden relative">
    <div class="container-novory">
      
      <!-- Header -->
      <div class="max-w-3xl mb-14 md:mb-20 relative z-10">
        <h2 class="text-3xl md:text-5xl font-bold text-text-dark-titles dark:text-white mb-6 tracking-tight leading-tight font-heading">
          Desarrollo Web de Alto Rendimiento <br class="hidden sm:block"/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-blue to-brand-cyan dark:from-brand-cyan dark:to-brand-blue">(SEO Integrado)</span>
        </h2>
        <p class="text-lg md:text-xl text-text-dark dark:text-text-secondary leading-relaxed font-light">
          Diseñamos plataformas a medida que no solo deslumbran visualmente, sino que están construidas con una arquitectura moderna para cargar en milisegundos y posicionarse orgánicamente en buscadores.
        </p>
      </div>

      <!-- MOBILE LAYOUT (Carrusel horizontal) -->
      <div class="md:hidden flex overflow-x-auto snap-x snap-mandatory pb-8 -mx-4 px-4 gap-6 no-scrollbar relative z-10">
        {webProjects.map((project) => (
          <div class="min-w-[90%] sm:min-w-[70%] snap-center flex flex-col gap-5">
            <div class="relative w-full aspect-video rounded-3xl overflow-hidden shadow-lg border border-light-border/50 dark:border-white/10 bg-light-surface dark:bg-dark-surface/50">
              <Image 
                src={project.images[0]} 
                alt={project.title} 
                class="absolute inset-0 w-full h-full object-cover object-top"
                width={600}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="px-2">
              <h3 class="text-xl font-bold text-text-dark-titles dark:text-white font-heading">{project.title}</h3>
              <p class="text-text-dark/80 dark:text-text-secondary mt-2 text-sm leading-relaxed">{project.description}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- DESKTOP LAYOUT (Tabs & Cascade) -->
      <div class="hidden md:grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center web-dev-desktop relative z-10">
        
        <!-- Pestañas (Izquierda, col 1-4) -->
        <div class="lg:col-span-4 flex flex-col gap-4" role="tablist">
          {webProjects.map((project, index) => (
            <a 
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class={`web-dev-tab block text-left p-6 rounded-3xl transition-all duration-300 border focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue cursor-pointer
                ${index === 0 
                  ? 'bg-light-surface dark:bg-dark-surface border-brand-blue/20 dark:border-brand-cyan/20 shadow-sm' 
                  : 'bg-transparent border-transparent hover:bg-light-surface/50 dark:hover:bg-dark-surface/50'
                } group`}
              data-target={project.id}
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
            >
              <h3 class={`text-xl xl:text-2xl font-bold mb-3 font-heading transition-colors 
                ${index === 0 
                  ? 'text-brand-blue dark:text-brand-cyan' 
                  : 'text-text-dark-titles dark:text-white group-hover:text-brand-blue dark:group-hover:text-brand-cyan'
                }`}>
                {project.title}
              </h3>
              <p class={`text-sm xl:text-base leading-relaxed transition-colors 
                ${index === 0 
                  ? 'text-text-dark dark:text-text-secondary' 
                  : 'text-text-light dark:text-text-dark group-hover:text-text-dark dark:group-hover:text-text-secondary'
                }`}>
                {project.description}
              </p>
            </a>
          ))}
        </div>

        <!-- Contenedor Visual (Derecha, col 5-12) -->
        <div class="lg:col-span-8 relative h-[500px] lg:h-[650px] w-full rounded-[2.5rem] overflow-hidden group/container">
          <!-- Fondo decorativo del contenedor -->
          <div class="absolute inset-0 bg-light-surface/50 dark:bg-dark-surface/30 border border-light-border/40 dark:border-dark-border/40 rounded-[2.5rem]"></div>
          
          {webProjects.map((project, index) => (
            <div 
              class="web-dev-visual absolute inset-0 transition-opacity duration-700 ease-in-out p-6 lg:p-10"
              data-id={project.id}
              style={`opacity: ${index === 0 ? '1' : '0'}; pointer-events: ${index === 0 ? 'auto' : 'none'}; z-index: ${index === 0 ? '10' : '0'};`}
            >
              <!-- Imágenes en cascada -->
              <div class="relative w-full h-full flex items-center justify-center group/images">
                
                <!-- Imagen 3 (Fondo izquierda) -->
                <div class="absolute top-[8%] left-[2%] lg:left-[5%] w-[65%] lg:w-[60%] aspect-[16/10] rounded-2xl overflow-hidden shadow-lg border border-light-border dark:border-white/10 transform -rotate-3 hover:-translate-y-2 hover:shadow-[0_0_30px_rgba(79,125,255,0.2)] dark:hover:shadow-[0_0_30px_rgba(68,162,255,0.25)] hover:!z-40 transition-all duration-500 z-10 cursor-default bg-light-base dark:bg-dark-base group-hover/images:brightness-75 group-hover/images:opacity-90 hover:!brightness-100 hover:!opacity-100">
                  <Image src={project.images[2]} alt={`${project.title} View 3`} class="w-full h-full object-cover object-top" width={800} />
                </div>
                
                <!-- Imagen 2 (Fondo derecha) -->
                <div class="absolute top-[18%] right-[2%] lg:right-[5%] w-[65%] lg:w-[60%] aspect-[16/10] rounded-2xl overflow-hidden shadow-lg border border-light-border dark:border-white/10 transform rotate-2 hover:-translate-y-2 hover:shadow-[0_0_30px_rgba(79,125,255,0.2)] dark:hover:shadow-[0_0_30px_rgba(68,162,255,0.25)] hover:!z-40 transition-all duration-500 z-20 cursor-default bg-light-base dark:bg-dark-base group-hover/images:brightness-75 group-hover/images:opacity-90 hover:!brightness-100 hover:!opacity-100">
                  <Image src={project.images[1]} alt={`${project.title} View 2`} class="w-full h-full object-cover object-top" width={800} />
                </div>
                
                <!-- Imagen 1 (Frente centro) -->
                <div class="absolute bottom-[5%] lg:bottom-[8%] left-[10%] lg:left-[15%] w-[80%] lg:w-[70%] aspect-[16/10] rounded-2xl overflow-hidden shadow-2xl border border-light-border/80 dark:border-white/20 transform hover:-translate-y-2 hover:shadow-[0_0_40px_rgba(79,125,255,0.3)] dark:hover:shadow-[0_0_40px_rgba(68,162,255,0.35)] hover:!z-40 transition-all duration-500 z-30 cursor-default bg-light-base dark:bg-dark-base group-hover/images:brightness-75 group-hover/images:opacity-90 hover:!brightness-100 hover:!opacity-100">
                  <Image src={project.images[0]} alt={`${project.title} View 1`} class="w-full h-full object-cover object-top" width={1000} />
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  function initWebDevTabs() {
    const tabs = document.querySelectorAll('.web-dev-tab');
    const visuals = document.querySelectorAll('.web-dev-visual');
    
    if (tabs.length === 0) return;

    const activateTab = (tab: Element) => {
      const targetId = tab.getAttribute('data-target');
      
      // Actualizar Pestañas
      tabs.forEach(t => {
        const isSelected = t === tab;
        t.setAttribute('aria-selected', isSelected.toString());
        
        if (isSelected) {
          t.classList.add('bg-light-surface', 'dark:bg-dark-surface', 'border-brand-blue/20', 'dark:border-brand-cyan/20', 'shadow-sm');
          t.classList.remove('bg-transparent', 'border-transparent');
          t.querySelector('h3')?.classList.add('text-brand-blue', 'dark:text-brand-cyan');
          t.querySelector('h3')?.classList.remove('text-text-dark-titles', 'dark:text-white', 'group-hover:text-brand-blue', 'dark:group-hover:text-brand-cyan');
          t.querySelector('p')?.classList.add('text-text-dark', 'dark:text-text-secondary');
          t.querySelector('p')?.classList.remove('text-text-light', 'dark:text-text-dark', 'group-hover:text-text-dark', 'dark:group-hover:text-text-secondary');
        } else {
          t.classList.remove('bg-light-surface', 'dark:bg-dark-surface', 'border-brand-blue/20', 'dark:border-brand-cyan/20', 'shadow-sm');
          t.classList.add('bg-transparent', 'border-transparent');
          t.querySelector('h3')?.classList.remove('text-brand-blue', 'dark:text-brand-cyan');
          t.querySelector('h3')?.classList.add('text-text-dark-titles', 'dark:text-white', 'group-hover:text-brand-blue', 'dark:group-hover:text-brand-cyan');
          t.querySelector('p')?.classList.remove('text-text-dark', 'dark:text-text-secondary');
          t.querySelector('p')?.classList.add('text-text-light', 'dark:text-text-dark', 'group-hover:text-text-dark', 'dark:group-hover:text-text-secondary');
        }
      });
      
      // Actualizar Visuales
      visuals.forEach((v) => {
        const visualEl = v as HTMLElement;
        if (visualEl.getAttribute('data-id') === targetId) {
          visualEl.style.opacity = '1';
          visualEl.style.pointerEvents = 'auto';
          visualEl.style.zIndex = '10';
        } else {
          visualEl.style.opacity = '0';
          visualEl.style.pointerEvents = 'none';
          visualEl.style.zIndex = '0';
        }
      });
    };

    tabs.forEach(tab => {
      // Usar hover y focus en lugar de click para cargar las imágenes
      tab.addEventListener('mouseenter', () => activateTab(tab));
      tab.addEventListener('focus', () => activateTab(tab));
    });
  }

  // Soporte para view transitions de Astro
  document.addEventListener('astro:page-load', initWebDevTabs);
</script>

<style>
  /* Ocultar barra de scroll en mobile */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
