---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServicesSection from '../components/sections/ServicesSection.astro';
import BenefitsSection from '../components/sections/BenefitsSection.astro';
import ProblemsSection from '../components/sections/ProblemsSection.astro';
---

<BaseLayout title="Servicios | Soluciones Digitales Inteligentes">
  <div>
    <ServicesSection />
    <BenefitsSection />
    <ProblemsSection />
  </div>
</BaseLayout>

<style is:global>
  /* Alinear la primera sección de servicios con el espaciado estándar del sitio (112px/128px) */
  #servicios {
    padding-top: 112px !important;
  }
  @media (min-width: 768px) {
    #servicios {
      padding-top: 128px !important;
    }
  }
</style>
