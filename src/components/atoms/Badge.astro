---
interface Props {
  class?: string;
  [key: string]: any;
}

const { class: className, ...rest } = Astro.props;
---

<span
  class:list={[
    // Base layout & Responsividad
    "inline-flex items-center font-medium rounded-full",
    "px-2.5 py-0.5 text-[11px] md:px-3 md:py-1 md:text-xs",

    // Modo Claro
    "bg-light-surface/60 border border-light-border/60 text-text-dark",

    // Modo Oscuro
    "dark:bg-white/5 dark:border-white/10 dark:text-text-light",

    // Animaciones y Efectos visuales (Efecto Glassmorphism integrado)
    "backdrop-blur-md transition-all duration-300 ease-[cubic-bezier(0.4,0.0,0.2,1)]",
    "hover:-translate-y-0.5 hover:shadow-sm hover:shadow-brand-blue/20",
    "hover-brand-gradient-text cursor-default",
    className,
  ]}
  {...rest}
>
  <slot />
</span>
