---
import { Sun, Moon } from "@lucide/astro";
---

<script is:inline>
  const getInitialTheme = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
      return "dark";
    }
    return "light";
  };

  const currentTheme = getInitialTheme();
  if (currentTheme === "dark") {
    document.documentElement.classList.add("dark");
  } else {
    document.documentElement.classList.remove("dark");
  }
  // Guardamos para que siempre haya un valor base
  if (typeof localStorage !== "undefined") {
    localStorage.setItem("theme", currentTheme);
  }
</script>

<theme-toggle class="block">
  <button
    class="relative flex h-8 w-16 cursor-pointer items-center rounded-full border-2 border-light-border bg-white transition-all duration-300 focus:outline-none hover:border-brand-blue/50 hover:shadow-[0_0_15px_rgba(68,102,255,0.2)] dark:border-dark-border dark:bg-dark-elevated dark:hover:border-brand-cyan/50 dark:hover:shadow-[0_0_15px_rgba(119,187,255,0.2)]"
    aria-label="Alternar tema oscuro/claro"
    type="button"
  >
    <div class="absolute inset-0 z-0 flex items-center justify-between px-1.5 pointer-events-none">
      <Moon class="h-4 w-4 text-brand-cyan opacity-40 transition-opacity duration-300 dark:opacity-100 dark:drop-shadow-[0_0_8px_rgba(119,187,255,0.8)]" />
      <Sun class="h-4 w-4 text-amber-500 opacity-100 drop-shadow-[0_0_8px_rgba(245,158,11,0.6)] transition-opacity duration-300 dark:opacity-40 dark:drop-shadow-none" />
    </div>

    <div
      class="absolute left-0.5 h-6 w-6 transform rounded-full bg-light-surface shadow-[0_2px_4px_rgba(0,0,0,0.15)] border border-gray-200 transition-transform duration-300 ease-[cubic-bezier(0.4,0.0,0.2,1)] pointer-events-none dark:translate-x-8 dark:bg-dark-base dark:border-brand-cyan/50 dark:shadow-[0_0_10px_rgba(119,187,255,0.4)]"
    ></div>
  </button>
</theme-toggle>

<script>
  // Definimos cómo se comporta nuestra etiqueta <theme-toggle>
  class ThemeToggle extends HTMLElement {
    constructor() {
      super();
      
      // Buscamos el botón dentro de nuestro componente
      const button = this.querySelector("button");

      if (button) {
        // Le agregamos el evento de clic de manera segura
        button.addEventListener("click", () => {
          // Cambiamos la clase en el HTML
          const isDark = document.documentElement.classList.toggle("dark");
          
          // Guardamos la preferencia
          localStorage.setItem("theme", isDark ? "dark" : "light");
        });
      }
    }
  }

  // Le decimos al navegador que registre nuestra etiqueta personalizada
  // El if previene errores si Astro intenta registrarlo dos veces
  if (!customElements.get("theme-toggle")) {
    customElements.define("theme-toggle", ThemeToggle);
  }
</script>