---
import { Sun, Moon } from "@lucide/astro";
---

<button 
  class="theme-toggle p-2.5 rounded-full bg-light-surface dark:bg-dark-surface border border-light-border dark:border-dark-border transition-all duration-300 hover:scale-110 hover:shadow-[0_0_15px_rgba(68,102,255,0.4)] relative overflow-hidden group focus:outline-none"
  aria-label="Alternar tema oscuro/claro"
>
  <span class="absolute inset-0 flex items-center justify-center transition-all duration-500 ease-[cubic-bezier(0.4,0.0,0.2,1)] dark:opacity-0 dark:rotate-90 dark:scale-50 opacity-100 rotate-0 scale-100">
    <Sun class="w-5 h-5 text-amber-500 drop-shadow-md" />
  </span>

  <span class="absolute inset-0 flex items-center justify-center transition-all duration-500 ease-[cubic-bezier(0.4,0.0,0.2,1)] opacity-0 -rotate-90 scale-50 dark:opacity-100 dark:rotate-0 dark:scale-100">
    <Moon class="w-5 h-5 text-brand-cyan drop-shadow-[0_0_8px_rgba(119,187,255,0.8)]" />
  </span>
</button>

<script is:inline>
  // 1. Definir el tema inicial sin esperar al DOM
  const theme = (() => {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      return localStorage.getItem('theme');
    }
    // Si no hay preferencia, lee la del sistema operativo
    if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
      return 'dark';
    }
    return 'light';
  })();

  // 2. Aplicarlo inmediatamente al HTML
  if (theme === 'light') {
    document.documentElement.classList.remove('dark');
  } else {
    document.documentElement.classList.add('dark');
  }
  window.localStorage.setItem('theme', theme);

  // 3. Lógica para el click (espera al DOM)
  document.addEventListener("DOMContentLoaded", () => {
    const handleToggleClick = () => {
      const element = document.documentElement;
      element.classList.toggle("dark");
      
      const isDark = element.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    }

    // Seleccionamos TODOS los botones con la clase theme-toggle
    const toggles = document.querySelectorAll(".theme-toggle");
    toggles.forEach(toggle => {
      toggle.addEventListener("click", handleToggleClick);
    });
  });
</script>