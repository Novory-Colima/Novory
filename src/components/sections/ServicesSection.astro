---
import Section from '../layout/Section.astro';
import ServiceBlock from '../molecules/ServiceBlock.astro';
import { Search, Globe, Zap, Map as MapIcon, Share2, MousePointer2, Layout, Smartphone } from '@lucide/astro';

const services = [
  {
    title: 'Desarrollo Web',
    description: 'Un sitio web es mucho más que una tarjeta de presentación. Es tu herramienta de ventas 24/7 diseñada para convertir cada visita en un cliente potencial.',
    benefits: [
      'Mayor confianza y mejor imagen profesional.',
      'Optimizado al 100% para dispositivos móviles.',
      'Arquitectura preparada para SEO y carga ultra-rápida.',
    ],
    ctaText: 'Conocer más',
    ctaHref: '/servicios/desarrollo-web',
    imageSide: 'right' as const,
  },
  {
    title: 'SEO Local',
    description: 'Una página impecable no sirve de nada si nadie la encuentra. Te posicionamos donde tus clientes están buscando activamente tus servicios hoy mismo.',
    benefits: [
      'Más visibilidad local y aumento de llamadas reales.',
      'Optimización estratégica de Google Business Profile.',
      'Dominio en los resultados de búsqueda de mapas locales.',
    ],
    ctaText: 'Descubrir SEO Local',
    ctaHref: '/servicios/seo-local',
    imageSide: 'left' as const,
  },
  {
    title: 'Automatizaciones',
    description: 'La tecnología moderna puede ahorrarte horas de trabajo manual todos los días. Creamos sistemas que trabajan por ti mientras tú descansas.',
    benefits: [
      'Atención por WhatsApp automatizada e inteligente.',
      'Formularios dinámicos que califican a tus prospectos.',
      'Integraciones fluidas que eliminan tareas repetitivas.',
    ],
    ctaText: 'Explorar automatizaciones',
    ctaHref: '/servicios/automatizaciones',
    imageSide: 'right' as const,
  },
];
---

<Section id="servicios" class="bg-bg-primary relative">
  <!-- Section Background Decorative Glow -->
  <div class="absolute left-0 top-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-accent/5 blur-[150px] rounded-full pointer-events-none"></div>

  <div class="max-w-4xl mx-auto text-center mb-20 flex flex-col gap-6 section-header">
    <h2 class="text-white">Soluciones digitales diseñadas para hacer crecer tu negocio.</h2>
    <p class="text-text-secondary text-xl leading-relaxed">
      Creamos herramientas inteligentes que trabajan para ti <br class="hidden md:block" /> incluso cuando tu negocio está cerrado.
    </p>
  </div>

  <div class="flex flex-col gap-10 md:gap-20">
    <!-- Service 1: Web -->
    <ServiceBlock {...services[0]}>
      <div slot="visual" class="w-full h-full relative flex items-center justify-center">
        <!-- Main Browser -->
        <div class="w-[85%] h-[80%] glass-panel border-white/10 shadow-2xl relative z-10 p-4 bg-white/[0.03] flex flex-col gap-3">
          <div class="flex gap-2 pb-2 border-b border-white/5">
            <div class="w-2.5 h-2.5 rounded-full bg-white/20"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-white/10"></div>
          </div>
          <div class="flex-1 grid grid-cols-12 gap-3">
            <div class="col-span-4 bg-white/5 rounded-lg"></div>
            <div class="col-span-8 flex flex-col gap-3">
               <div class="h-4 bg-white/10 rounded-full w-3/4"></div>
               <div class="h-20 bg-white/5 rounded-lg"></div>
               <div class="mt-auto h-8 bg-accent/20 rounded-lg w-1/3"></div>
            </div>
          </div>
        </div>
        <!-- Mobile Overlay -->
        <div class="absolute -bottom-6 right-0 w-[28%] h-[65%] glass-panel border-white/20 shadow-2xl z-20 p-3 flex flex-col gap-2 bg-bg-primary/80 backdrop-blur-3xl">
          <div class="w-8 h-1 bg-white/20 rounded-full mx-auto mb-3"></div>
          <div class="h-1/4 bg-white/10 rounded-lg"></div>
          <div class="h-1/2 bg-white/5 rounded-lg"></div>
          <div class="h-6 bg-accent rounded-md mt-auto"></div>
        </div>
        <div class="absolute top-10 right-20 z-30 animate-bounce duration-1000">
           <MousePointer2 class="w-8 h-8 text-accent shadow-glow" fill="currentColor" />
        </div>
      </div>
    </ServiceBlock>

    <!-- Service 2: SEO -->
    <ServiceBlock {...services[1]}>
      <div slot="visual" class="w-full h-full relative flex items-center justify-center">
        <div class="w-[90%] h-[90%] glass-panel border-white/10 p-8 flex flex-col gap-8 bg-white/[0.02]">
          <div class="flex items-center gap-5 border-b border-white/5 pb-6">
            <div class="w-12 h-12 rounded-2xl bg-accent/20 flex items-center justify-center text-accent shadow-glow">
              <Search class="w-6 h-6" />
            </div>
            <div class="flex flex-col gap-2 flex-1">
              <div class="w-2/3 h-3 bg-white/10 rounded-full"></div>
              <div class="w-1/2 h-2 bg-white/5 rounded-full"></div>
            </div>
          </div>
          <div class="grid grid-cols-1 gap-4 flex-1">
             <div class="bg-white/5 rounded-2xl border border-white/5 p-4 flex items-center gap-4 group/item hover:bg-white/10 transition-colors">
                <div class="w-10 h-10 rounded-full bg-accent/30 flex items-center justify-center text-accent">
                   <MapIcon class="w-5 h-5" />
                </div>
                <div class="flex flex-col gap-2 flex-1">
                   <div class="w-1/3 h-3 bg-white/10 rounded-full"></div>
                   <div class="w-full h-2 bg-white/5 rounded-full"></div>
                </div>
             </div>
             <div class="bg-white/5 rounded-2xl border border-white/5 p-4 flex items-center gap-4 opacity-60">
                <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-white/30">
                   <MapIcon class="w-5 h-5" />
                </div>
                <div class="flex flex-col gap-2 flex-1">
                   <div class="w-1/4 h-3 bg-white/10 rounded-full"></div>
                   <div class="w-2/3 h-2 bg-white/5 rounded-full"></div>
                </div>
             </div>
          </div>
        </div>
      </div>
    </ServiceBlock>

    <!-- Service 3: Automation -->
    <ServiceBlock {...services[2]}>
      <div slot="visual" class="w-full h-full relative flex items-center justify-center">
        <!-- Central connection node -->
        <div class="absolute inset-0 flex items-center justify-center">
           <svg class="w-full h-full opacity-10" viewBox="0 0 200 200">
              <circle cx="100" cy="100" r="70" fill="none" stroke="currentColor" stroke-width="0.5" stroke-dasharray="2 2" />
              <line x1="100" y1="100" x2="160" y2="40" stroke="currentColor" stroke-width="0.5" />
              <line x1="100" y1="100" x2="160" y2="160" stroke="currentColor" stroke-width="0.5" />
              <line x1="100" y1="100" x2="40" y2="100" stroke="currentColor" stroke-width="0.5" />
           </svg>
        </div>
        
        <div class="relative z-10 grid grid-cols-2 gap-12">
           <div class="w-20 h-20 rounded-3xl glass-panel flex items-center justify-center text-accent shadow-glow border-accent/20 animate-float-slow bg-white/[0.05]">
              <Zap class="w-10 h-10" />
           </div>
           <div class="w-20 h-20 rounded-3xl glass-panel flex items-center justify-center text-white/40 border-white/5 -translate-y-12 animate-float-slow-delayed bg-white/[0.02]">
              <Share2 class="w-10 h-10" />
           </div>
           <div class="w-20 h-20 rounded-3xl glass-panel flex items-center justify-center text-accent shadow-glow border-accent/20 translate-x-12 animate-float-slow bg-white/[0.05]">
              <Smartphone class="w-10 h-10" />
           </div>
           <div class="w-20 h-20 rounded-3xl glass-panel flex items-center justify-center text-white/40 border-white/5 animate-float-slow-delayed bg-white/[0.02]">
              <Globe class="w-10 h-10" />
           </div>
        </div>
      </div>
    </ServiceBlock>
  </div>
</Section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initServices() {
    gsap.utils.toArray('.service-block-reveal').forEach((block: any) => {
      gsap.to(block, {
        scrollTrigger: {
          trigger: block,
          start: 'top 85%',
        },
        y: 0,
        opacity: 1,
        duration: 1.2,
        ease: 'power4.out',
      });
    });
  }

  window.addEventListener('load', initServices);
  document.addEventListener('astro:page-load', initServices);
</script>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  
  @keyframes float-delayed {
    0%, 100% { transform: translateY(-48px); }
    50% { transform: translateY(-58px); }
  }

  .animate-float-slow {
    animation: float 5s ease-in-out infinite;
  }

  .animate-float-slow-delayed {
    animation: float-delayed 6s ease-in-out infinite 0.5s;
  }
</style>
