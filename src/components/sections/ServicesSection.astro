---
import Section from "../layout/Section.astro";
import ServiceBlock from "../molecules/ServiceBlock.astro";
import {
  Search,
  Globe,
  Zap,
  Map as MapIcon,
  Share2,
  MousePointer2,
  Layout,
  Smartphone,
} from "@lucide/astro";

const services = [
  {
    title: "Desarrollo Web",
    description:
      "Un sitio web es mucho más que una tarjeta de presentación. Es tu herramienta de ventas 24/7 diseñada para convertir cada visita en un cliente potencial.",
    benefits: [
      "Mayor confianza y mejor imagen profesional.",
      "Optimizado al 100% para dispositivos móviles.",
      "Arquitectura preparada para SEO y carga ultra-rápida.",
    ],
    ctaText: "Conocer más",
    ctaHref: "/servicios/desarrollo-web",
    imageSide: "right" as const,
  },
  {
    title: "SEO Local",
    description:
      "Una página impecable no sirve de nada si nadie la encuentra. Te posicionamos donde tus clientes están buscando activamente tus servicios hoy mismo.",
    benefits: [
      "Más visibilidad local y aumento de llamadas reales.",
      "Optimización estratégica de Google Business Profile.",
      "Dominio en los resultados de búsqueda de mapas locales.",
    ],
    ctaText: "Descubrir SEO Local",
    ctaHref: "/servicios/seo-local",
    imageSide: "left" as const,
  },
  {
    title: "Automatizaciones",
    description:
      "La tecnología moderna puede ahorrarte horas de trabajo manual todos los días. Creamos sistemas que trabajan por ti mientras tú descansas.",
    benefits: [
      "Atención por WhatsApp automatizada e inteligente.",
      "Formularios dinámicos que califican a tus prospectos.",
      "Integraciones fluidas que eliminan tareas repetitivas.",
    ],
    ctaText: "Explorar automatizaciones",
    ctaHref: "/servicios/automatizaciones",
    imageSide: "right" as const,
  },
];
---

<services-section class="block">
  <Section
    id="servicios"
    class="bg-light-base dark:bg-dark-base relative transition-colors duration-500"
  >
    <!-- Section Background Decorative Glow -->
    <div
      class="absolute left-0 top-1/2 -translate-y-1/2 w-100 md:w-125 h-100 md:h-125 bg-brand-cyan/15 dark:bg-brand-blue/5 blur-[120px] md:blur-[150px] rounded-full pointer-events-none transition-colors"
    >
    </div>

    <div
      class="max-w-4xl mx-auto text-center mb-16 md:mb-20 flex flex-col gap-4 md:gap-6 section-header px-4"
    >
      <h2
        class="text-text-dark-titles dark:text-white text-3xl md:text-5xl font-bold tracking-tight transition-colors"
      >
        Soluciones digitales diseñadas para <span
          class="bg-clip-text text-transparent bg-linear-to-r from-brand-cyan via-brand-blue to-brand-purple"
          >hacer crecer tu negocio.</span>
      </h2>
      <p
        class="text-text-dark dark:text-text-secondary text-base md:text-xl leading-relaxed transition-colors"
      >
        Creamos herramientas inteligentes que trabajan para ti <br
          class="hidden md:block"
        /> incluso cuando tu negocio está cerrado.
      </p>
    </div>

    <div class="flex flex-col gap-16 md:gap-20">
      <!-- Service 1: Web -->
      <ServiceBlock {...services[0]}>
        <div
          slot="visual"
          class="w-full h-full relative flex items-center justify-center"
        >
          <!-- Main Browser -->
          <div
            class="w-[90%] md:w-[85%] h-[80%] bg-light-surface/80 dark:bg-white/3 backdrop-blur-md border border-light-border/50 dark:border-white/10 shadow-lg dark:shadow-2xl rounded-xl relative z-10 p-3 md:p-4 flex flex-col gap-3 transition-colors"
          >
            <div
              class="flex gap-2 pb-2 border-b border-light-border/40 dark:border-white/5"
            >
              <div
                class="w-2.5 h-2.5 rounded-full bg-light-border dark:bg-white/20"
              >
              </div>
              <div
                class="w-2.5 h-2.5 rounded-full bg-light-border/60 dark:bg-white/10"
              >
              </div>
            </div>
            <div class="flex-1 grid grid-cols-12 gap-3">
              <div class="col-span-4 bg-black/5 dark:bg-white/5 rounded-lg">
              </div>
              <div class="col-span-8 flex flex-col gap-3">
                <div
                  class="h-4 bg-black/10 dark:bg-white/10 rounded-full w-3/4"
                >
                </div>
                <div class="h-20 bg-black/5 dark:bg-white/5 rounded-lg"></div>
                <div
                  class="mt-auto h-8 bg-brand-blue/20 dark:bg-brand-cyan/20 rounded-lg w-1/2 md:w-1/3"
                >
                </div>
              </div>
            </div>
          </div>
          <!-- Mobile Overlay -->
          <div
            class="absolute -bottom-4 right-0 md:-bottom-6 md:right-4 w-[35%] md:w-[28%] h-[60%] md:h-[65%] bg-light-base/90 dark:bg-dark-base/80 backdrop-blur-2xl border border-light-border/60 dark:border-white/20 shadow-xl dark:shadow-2xl z-20 p-2 md:p-3 flex flex-col gap-2 rounded-[1rem] transition-colors"
          >
            <div
              class="w-6 md:w-8 h-1 bg-black/20 dark:bg-white/20 rounded-full mx-auto mb-2 md:mb-3"
            >
            </div>
            <div class="h-1/4 bg-black/10 dark:bg-white/10 rounded-lg"></div>
            <div class="h-1/2 bg-black/5 dark:bg-white/5 rounded-lg"></div>
            <div
              class="h-5 md:h-6 bg-brand-blue dark:bg-brand-cyan rounded-md mt-auto shadow-[0_0_10px_rgba(68,102,255,0.3)]"
            >
            </div>
          </div>
          <div
            class="absolute top-6 right-10 md:top-10 md:right-20 z-30 animate-bounce"
            style="animation-duration: 2s;"
          >
            <MousePointer2
              class="w-6 h-6 md:w-8 md:h-8 text-brand-blue dark:text-brand-cyan drop-shadow-md dark:shadow-glow"
              fill="currentColor"
            />
          </div>
        </div>
      </ServiceBlock>

      <!-- Service 2: SEO -->
      <ServiceBlock {...services[1]}>
        <div
          slot="visual"
          class="w-full h-full relative flex items-center justify-center"
        >
          <div
            class="w-[95%] md:w-[90%] h-[90%] bg-light-surface/50 dark:bg-white/2 backdrop-blur-md border border-light-border/40 dark:border-white/10 p-6 md:p-8 flex flex-col gap-6 md:gap-8 rounded-(--radius-xl) transition-colors"
          >
            <div
              class="flex items-center gap-4 md:gap-5 border-b border-light-border/40 dark:border-white/5 pb-4 md:pb-6"
            >
              <div
                class="w-10 h-10 md:w-12 md:h-12 rounded-2xl bg-brand-cyan/20 dark:bg-brand-blue/20 flex items-center justify-center text-brand-blue dark:text-brand-cyan shadow-sm dark:shadow-glow shrink-0"
              >
                <Search class="w-5 h-5 md:w-6 md:h-6" />
              </div>
              <div class="flex flex-col gap-2 flex-1">
                <div
                  class="w-2/3 h-2.5 md:h-3 bg-black/10 dark:bg-white/10 rounded-full"
                >
                </div>
                <div
                  class="w-1/2 h-1.5 md:h-2 bg-black/5 dark:bg-white/5 rounded-full"
                >
                </div>
              </div>
            </div>
            <div class="grid grid-cols-1 gap-3 md:gap-4 flex-1">
              <div
                class="bg-light-base dark:bg-white/5 rounded-2xl border border-brand-blue/20 dark:border-white/5 p-3 md:p-4 flex items-center gap-3 md:gap-4 group/item hover:bg-light-surface dark:hover:bg-white/10 transition-colors shadow-sm dark:shadow-none"
              >
                <div
                  class="w-8 h-8 md:w-10 md:h-10 rounded-full bg-brand-blue/10 dark:bg-brand-cyan/20 flex items-center justify-center text-brand-blue dark:text-brand-cyan shrink-0"
                >
                  <MapIcon class="w-4 h-4 md:w-5 md:h-5" />
                </div>
                <div class="flex flex-col gap-2 flex-1">
                  <div
                    class="w-1/3 h-2.5 md:h-3 bg-black/15 dark:bg-white/10 rounded-full"
                  >
                  </div>
                  <div
                    class="w-[90%] h-1.5 md:h-2 bg-black/5 dark:bg-white/5 rounded-full"
                  >
                  </div>
                </div>
              </div>
              <div
                class="bg-light-base/50 dark:bg-white/2 rounded-2xl border border-light-border/30 dark:border-white/5 p-3 md:p-4 flex items-center gap-3 md:gap-4 opacity-70 dark:opacity-60 transition-colors"
              >
                <div
                  class="w-8 h-8 md:w-10 md:h-10 rounded-full bg-black/5 dark:bg-white/10 flex items-center justify-center text-text-dark dark:text-white/30 shrink-0"
                >
                  <MapIcon class="w-4 h-4 md:w-5 md:h-5" />
                </div>
                <div class="flex flex-col gap-2 flex-1">
                  <div
                    class="w-1/4 h-2.5 md:h-3 bg-black/10 dark:bg-white/10 rounded-full"
                  >
                  </div>
                  <div
                    class="w-2/3 h-1.5 md:h-2 bg-black/5 dark:bg-white/5 rounded-full"
                  >
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </ServiceBlock>

      <!-- Service 3: Automation -->
      <ServiceBlock {...services[2]}>
        <div
          slot="visual"
          class="w-full h-full relative flex items-center justify-center"
        >
          <!-- Central connection node -->
          <div
            class="absolute inset-0 flex items-center justify-center pointer-events-none"
          >
            <svg
              class="w-[80%] h-[80%] opacity-20 dark:opacity-10 text-brand-blue dark:text-white transition-colors"
              viewBox="0 0 200 200"
            >
              <circle
                cx="100"
                cy="100"
                r="70"
                fill="none"
                stroke="currentColor"
                stroke-width="1"
                stroke-dasharray="4 4"></circle>
              <line
                x1="100"
                y1="100"
                x2="160"
                y2="40"
                stroke="currentColor"
                stroke-width="1"></line>
              <line
                x1="100"
                y1="100"
                x2="160"
                y2="160"
                stroke="currentColor"
                stroke-width="1"></line>
              <line
                x1="100"
                y1="100"
                x2="40"
                y2="100"
                stroke="currentColor"
                stroke-width="1"></line>
            </svg>
          </div>

          <div class="relative z-10 grid grid-cols-2 gap-8 md:gap-12">
            <div
              class="w-16 h-16 md:w-20 md:h-20 rounded-[1rem] md:rounded-3xl bg-light-base/90 dark:bg-white/5 backdrop-blur-md flex items-center justify-center text-brand-blue dark:text-brand-cyan shadow-md dark:shadow-glow border border-brand-blue/20 dark:border-brand-cyan/20 animate-float-slow transition-colors"
            >
              <Zap class="w-8 h-8 md:w-10 md:h-10" />
            </div>
            <div
              class="w-16 h-16 md:w-20 md:h-20 rounded-[1rem] md:rounded-3xl bg-light-surface/60 dark:bg-white/2 backdrop-blur-md flex items-center justify-center text-text-dark dark:text-white/40 border border-light-border/40 dark:border-white/5 -translate-y-8 md:-translate-y-12 animate-float-slow-delayed transition-colors"
            >
              <Share2 class="w-8 h-8 md:w-10 md:h-10" />
            </div>
            <div
              class="w-16 h-16 md:w-20 md:h-20 rounded-[1rem] md:rounded-3xl bg-light-base/90 dark:bg-white/5 backdrop-blur-md flex items-center justify-center text-brand-blue dark:text-brand-cyan shadow-md dark:shadow-glow border border-brand-blue/20 dark:border-brand-cyan/20 translate-x-6 md:translate-x-12 animate-float-slow transition-colors"
            >
              <Smartphone class="w-8 h-8 md:w-10 md:h-10" />
            </div>
            <div
              class="w-16 h-16 md:w-20 md:h-20 rounded-[1rem] md:rounded-3xl bg-light-surface/60 dark:bg-white/2 backdrop-blur-md flex items-center justify-center text-text-dark dark:text-white/40 border border-light-border/40 dark:border-white/5 animate-float-slow-delayed transition-colors"
            >
              <Globe class="w-8 h-8 md:w-10 md:h-10" />
            </div>
          </div>
        </div>
      </ServiceBlock>
    </div>
  </Section>
</services-section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  class ServicesSection extends HTMLElement {
    ctx: gsap.Context | null = null;

    connectedCallback() {
      this.ctx = gsap.context(() => {
        gsap.utils.toArray(".service-block-reveal").forEach((block: any) => {
          gsap.fromTo(
            block,
            { y: 40, opacity: 0 },
            {
              scrollTrigger: {
                trigger: block,
                start: "top 85%",
              },
              y: 0,
              opacity: 1,
              duration: 1.2,
              ease: "power4.out",
            },
          );
        });
      }, this);
    }

    disconnectedCallback() {
      if (this.ctx) {
        this.ctx.revert();
        this.ctx = null;
      }
    }
  }

  if (!customElements.get("services-section")) {
    customElements.define("services-section", ServicesSection);
  }
</script>

<style>
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  @keyframes float-delayed {
    0%,
    100% {
      transform: translateY(-20px);
    }
    50% {
      transform: translateY(-30px);
    }
  }

  @media (min-width: 768px) {
    @keyframes float-delayed {
      0%,
      100% {
        transform: translateY(-48px);
      }
      50% {
        transform: translateY(-58px);
      }
    }
  }

  .animate-float-slow {
    animation: float 5s ease-in-out infinite;
  }

  .animate-float-slow-delayed {
    animation: float-delayed 6s ease-in-out infinite 0.5s;
  }
</style>
