---
import Section from '../layout/Section.astro';
import { Compass, PencilRuler, Palette, Code, Zap, Rocket, HeartHandshake } from '@lucide/astro';

const steps = [
  {
    title: 'Descubrimiento',
    description: 'Comprendemos completamente tu negocio, público objetivo y desafíos actuales para sentar las bases del éxito.',
    icon: Compass,
  },
  {
    title: 'Estrategia',
    description: 'Definimos la arquitectura, estrategia SEO y automatizaciones ideales diseñadas específicamente para tus objetivos.',
    icon: PencilRuler,
  },
  {
    title: 'Diseño',
    description: 'Creamos una experiencia moderna, intuitiva y optimizada para la conversión, respetando la identidad de tu marca.',
    icon: Palette,
  },
  {
    title: 'Desarrollo',
    description: 'Construimos tu producto utilizando tecnología de alto rendimiento, asegurando solidez y escalabilidad.',
    icon: Code,
  },
  {
    title: 'Optimización',
    description: 'Afinamos cada detalle: velocidad de carga, SEO Local y cumplimiento de los Core Web Vitals de Google.',
    icon: Zap,
  },
  {
    title: 'Lanzamiento',
    description: 'Tu proyecto cobra vida con dominio, hosting y analítica configurada para medir cada resultado desde el día uno.',
    icon: Rocket,
  },
  {
    title: 'Acompañamiento',
    description: 'Nuestra relación no termina con la entrega. Te acompañamos en la evolución continua de tu negocio digital.',
    icon: HeartHandshake,
  },
];
---

<process-section class="block">
  <Section id="proceso" class="bg-light-surface/30 dark:bg-dark-elevated/20 relative transition-colors duration-500">
    <!-- Decorative background elements -->
    <div class="absolute top-1/2 left-0 w-100 md:w-150 h-100 md:h-150 bg-brand-cyan/10 dark:bg-brand-blue/5 blur-[120px] md:blur-[180px] rounded-full -translate-x-1/2 pointer-events-none transition-colors"></div>

    <div class="max-w-4xl mx-auto text-center mb-20 md:mb-28 flex flex-col gap-4 md:gap-6 section-header px-4">
      <h2 class="text-text-dark-titles dark:text-white text-3xl md:text-5xl font-bold tracking-tight transition-colors">Así convertimos una idea en resultados.</h2>
      <p class="text-text-dark dark:text-text-secondary text-base md:text-lg lg:text-xl leading-relaxed transition-colors">
        Cada proyecto sigue un proceso claro, colaborativo y enfocado en generar valor real <br class="hidden md:block" /> para tu negocio desde el primer día.
      </p>
    </div>

    <div class="relative max-w-5xl mx-auto px-6 md:px-0">
      <!-- Vertical Line -->
      <div class="absolute left-10 -translate-x-1/2 md:left-1/2 top-4 bottom-4 w-1 bg-light-border/40 dark:bg-white/5 overflow-hidden rounded-full transition-colors">
         <div id="timeline-progress" class="w-full h-0 bg-brand-blue dark:bg-brand-cyan shadow-[0_0_15px_rgba(68,102,255,0.5)] transition-all duration-300"></div>
      </div>

      <div class="flex flex-col gap-12 md:gap-24">
        {steps.map((step, index) => (
          <div class:list={['relative flex items-center md:justify-between timeline-item opacity-0', index % 2 === 0 ? 'md:flex-row-reverse' : 'md:flex-row']}>
            <!-- Content -->
            <div class:list={['pl-16 md:pl-0 md:w-[42%] flex flex-col gap-2 md:gap-4', index % 2 === 0 ? 'md:text-left' : 'md:text-right']}>
              <span class="text-brand-purple dark:text-brand-cyan font-bold text-xs md:text-sm tracking-widest uppercase mb-1 transition-colors">Paso {index + 1}</span>
              <h3 class="text-2xl md:text-3xl font-bold text-text-dark-titles dark:text-white tracking-tight transition-colors">{step.title}</h3>
              <p class="text-text-dark dark:text-text-secondary text-sm md:text-base lg:text-lg leading-relaxed transition-colors">{step.description}</p>
            </div>

            <!-- Icon/Node with ping ring -->
            <div class="absolute left-10 md:left-1/2 -translate-x-1/2 z-10 flex items-center justify-center">
              <div class="ping-ring absolute w-9 h-9 md:w-16 md:h-16 rounded-2xl bg-brand-blue/30 dark:bg-brand-cyan/30 opacity-0 pointer-events-none"></div>
              <div class="w-9 h-9 md:w-16 md:h-16 rounded-2xl bg-light-base dark:bg-dark-base border border-light-border dark:border-brand-blue/30 flex items-center justify-center text-brand-blue dark:text-brand-cyan shadow-sm dark:shadow-glow hover:scale-110 hover:border-brand-blue dark:hover:border-brand-cyan hover:bg-brand-blue hover:text-white transition-all duration-500 ease-[cubic-bezier(0.4,0.0,0.2,1)]">
                <step.icon class="w-5 h-5 md:w-7 md:h-7" />
              </div>
            </div>

            <!-- Spacer for md layout -->
            <div class="hidden md:block md:w-[42%]"></div>
          </div>
        ))}
      </div>
    </div>
  </Section>
</process-section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  class ProcessSection extends HTMLElement {
    ctx: gsap.Context | null = null;

    connectedCallback() {
      this.ctx = gsap.context(() => {
        // Line progress animation
        gsap.to('#timeline-progress', {
          scrollTrigger: {
            trigger: '#proceso',
            start: 'top 30%',
            end: 'bottom 70%',
            scrub: 1,
          },
          height: '100%',
          ease: 'none',
        });

        // Items reveal with alternating x direction + ping on node
        gsap.utils.toArray('.timeline-item').forEach((item: any, index: number) => {
          const xDir = index % 2 === 0 ? -60 : 60;
          gsap.fromTo(item,
            { x: xDir, opacity: 0 },
            {
              scrollTrigger: { trigger: item, start: 'top 85%' },
              x: 0, opacity: 1, duration: 1, ease: 'power3.out',
              onComplete: () => {
                const ring = item.querySelector('.ping-ring');
                if (ring) {
                  gsap.fromTo(ring,
                    { scale: 1, opacity: 0.5 },
                    { scale: 2.2, opacity: 0, duration: 1, ease: 'power2.out', repeat: 2, repeatDelay: 0.4 }
                  );
                }
              }
            }
          );
        });
      }, this);
    }

    disconnectedCallback() {
      if (this.ctx) {
        this.ctx.revert();
        this.ctx = null;
      }
    }
  }

  if (!customElements.get('process-section')) {
    customElements.define('process-section', ProcessSection);
  }
</script>
