---
import Section from '../layout/Section.astro';
import Button from '../atoms/Button.astro';
import { CheckCircle2, Phone, Mail, Sparkles } from '@lucide/astro';

const trustItems = [
  'Respuesta personalizada en menos de 24h.',
  'Asesoría estratégica inicial sin compromiso.',
  'Atención directa con especialistas técnicos.',
  'Soluciones adaptadas a la realidad de tu negocio.'
];
---

<Section id="contacto" class="bg-bg-primary relative overflow-hidden">
  <!-- Decorative background elements -->
  <div class="absolute bottom-0 right-0 w-200 h-200 bg-accent/4 blur-[150px] rounded-full translate-y-1/2 translate-x-1/2 pointer-events-none"></div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-32 items-start relative z-10">
    <!-- Left Column: Context -->
    <div class="lg:col-span-5 flex flex-col gap-12 sticky top-32">
      <div class="flex flex-col gap-8">
        <div class="flex items-center gap-3">
           <div class="w-10 h-10 rounded-xl bg-accent/10 flex items-center justify-center text-accent">
              <Sparkles class="w-5 h-5" />
           </div>
           <span class="text-accent font-black text-xs md:text-sm tracking-[0.4em] uppercase">Contacto</span>
        </div>
        <h2 class="text-white text-5xl md:text-7xl font-bold tracking-tighter leading-[1.05]">¿Listo para transformar tu negocio?</h2>
        <p class="text-text-secondary text-xl md:text-2xl leading-relaxed font-light max-w-xl">
          Cuéntanos un poco sobre tu visión. Nos encantará ayudarte a encontrar la mejor ruta tecnológica para tu éxito.
        </p>
      </div>

      <div class="flex flex-col gap-8 py-4">
        {trustItems.map((item) => (
          <div class="flex items-start gap-5 text-white group">
            <div class="w-7 h-7 rounded-full bg-accent/20 flex items-center justify-center text-accent shrink-0 mt-0.5 group-hover:bg-accent group-hover:text-white transition-all duration-300">
               <CheckCircle2 class="w-4 h-4" />
            </div>
            <span class="text-xl font-medium text-white/90">{item}</span>
          </div>
        ))}
      </div>

      <div class="mt-4 flex flex-col gap-8 pt-12 border-t border-white/5">
         <div class="flex items-center gap-6 group cursor-pointer">
            <div class="w-14 h-14 rounded-2xl bg-white/5 flex items-center justify-center text-accent group-hover:bg-accent group-hover:text-white transition-all duration-500 shadow-glow">
               <Mail class="w-6 h-6" />
            </div>
            <div class="flex flex-col gap-1">
               <span class="text-[11px] text-text-secondary uppercase tracking-[0.2em] font-black">Email directo</span>
               <a href="mailto:hola@novory.com" class="text-xl md:text-2xl font-bold text-white hover:text-accent transition-colors">hola@novory.com</a>
            </div>
         </div>
         <div class="flex items-center gap-6 group cursor-pointer">
            <div class="w-14 h-14 rounded-2xl bg-white/5 flex items-center justify-center text-accent group-hover:bg-accent group-hover:text-white transition-all duration-500 shadow-glow">
               <Phone class="w-6 h-6" />
            </div>
            <div class="flex flex-col gap-1">
               <span class="text-[11px] text-text-secondary uppercase tracking-[0.2em] font-black">WhatsApp Business</span>
               <a href="#" class="text-xl md:text-2xl font-bold text-white hover:text-accent transition-colors">+34 600 000 000</a>
            </div>
         </div>
      </div>
    </div>

    <!-- Right Column: Form -->
    <div class="lg:col-span-7">
      <div class="glass-panel p-10 md:p-16 border-white/10 bg-white/2 shadow-2xl relative overflow-hidden">
        <!-- Inner glow -->
        <div class="absolute top-0 right-0 w-64 h-64 bg-accent/10 blur-[100px] -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>

        <form id="contact-form" class="flex flex-col gap-10 relative z-10">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
            <div class="flex flex-col gap-4">
              <label for="name" class="text-[11px] font-black text-text-muted tracking-[0.2em] uppercase ml-1">Tu Nombre</label>
              <input type="text" id="name" name="name" required class="bg-white/5 border border-white/10 rounded-2xl px-8 py-5 text-white text-lg outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-all placeholder:text-white/10" placeholder="Juan Pérez" />
            </div>
            <div class="flex flex-col gap-4">
              <label for="email" class="text-[11px] font-black text-text-muted tracking-[0.2em] uppercase ml-1">Correo Electrónico</label>
              <input type="email" id="email" name="email" required class="bg-white/5 border border-white/10 rounded-2xl px-8 py-5 text-white text-lg outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-all placeholder:text-white/10" placeholder="juan@ejemplo.com" />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
            <div class="flex flex-col gap-4">
              <label for="phone" class="text-[11px] font-black text-text-muted tracking-[0.2em] uppercase ml-1">Teléfono / WhatsApp</label>
              <input type="tel" id="phone" name="phone" required class="bg-white/5 border border-white/10 rounded-2xl px-8 py-5 text-white text-lg outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-all placeholder:text-white/10" placeholder="+34 000 000 000" />
            </div>
            <div class="flex flex-col gap-4">
              <label for="business" class="text-[11px] font-black text-text-muted tracking-[0.2em] uppercase ml-1">Nombre del Negocio</label>
              <input type="text" id="business" name="business" required class="bg-white/5 border border-white/10 rounded-2xl px-8 py-5 text-white text-lg outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-all placeholder:text-white/10" placeholder="Mi Negocio Local" />
            </div>
          </div>

          <div class="flex flex-col gap-4">
            <label for="industry" class="text-[11px] font-black text-text-muted tracking-[0.2em] uppercase ml-1">¿A qué se dedica tu negocio?</label>
            <input type="text" id="industry" name="industry" required class="bg-white/5 border border-white/10 rounded-2xl px-8 py-5 text-white text-lg outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-all placeholder:text-white/10" placeholder="Ej. Restaurante, Clínica Dental, Taller, etc." />
          </div>

          <div class="flex flex-col gap-4">
            <label for="message" class="text-[11px] font-black text-text-muted tracking-[0.2em] uppercase ml-1">Cuéntanos sobre tus objetivos</label>
            <textarea id="message" name="message" rows="5" class="bg-white/5 border border-white/10 rounded-2xl px-8 py-5 text-white text-lg outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-all resize-none placeholder:text-white/10" placeholder="Hola, me gustaría digitalizar mis pedidos y aparecer en Google..."></textarea>
          </div>

          <div class="pt-6">
            <Button variant="primary" size="hero" type="submit" class="w-full py-6! rounded-2xl! group/sub">
              <span class="font-black uppercase tracking-[0.3em] text-sm">Agendar Asesoría Gratuita</span>
              <Sparkles class="ml-3 w-5 h-5 group-hover/sub:scale-125 transition-transform" />
            </Button>
            <p class="text-center text-text-secondary text-sm mt-6 font-medium italic">Al enviar, serás redirigido a WhatsApp para una atención inmediata.</p>
          </div>
        </form>
      </div>
    </div>
  </div>
</Section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    
    // Create Structured WhatsApp Message as per requirement
    const text = `🚀 SOLICITUD DE ASESORÍA NOVORY\n\n` +
                 `👤 Nombre: ${data.name}\n` +
                 `🏢 Negocio: ${data.business}\n` +
                 `📍 Giro: ${data.industry}\n` +
                 `📧 Email: ${data.email}\n` +
                 `📞 Teléfono: ${data.phone}\n\n` +
                 `💬 Mensaje: ${data.message}`;
                 
    const encodedText = encodeURIComponent(text);
    const whatsappUrl = `https://wa.me/34600000000?text=${encodedText}`;

    // Simple feedback logic could go here
    window.open(whatsappUrl, '_blank');
  });
</script>
