---
import Section from '../layout/Section.astro';
import Button from '../atoms/Button.astro';
import { CheckCircle2, Phone, Mail, Sparkles } from '@lucide/astro';
import { CONTACT_INFO } from '../../utils/contact';
import { WHATSAPP_URLS } from '../../utils/whatsapp';

const trustItems = [
  'Respuesta personalizada en menos de 24h.',
  'Asesoría estratégica inicial sin compromiso.',
  'Atención directa con especialistas técnicos.',
  'Soluciones adaptadas a la realidad de tu negocio.'
];
---

<contact-section class="block">
  <Section id="contacto" class="bg-light-base dark:bg-dark-base relative overflow-hidden transition-colors duration-500">
    <div class="absolute bottom-0 right-0 w-100 h-100 md:w-200 md:h-200 bg-brand-cyan/15 dark:bg-brand-blue/5 blur-[120px] md:blur-[150px] rounded-full translate-y-1/2 translate-x-1/2 pointer-events-none transition-colors"></div>

    <div class="relative z-10 max-w-6xl mx-auto px-6 lg:px-8 py-10">
      <div class="contact-header w-full mb-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-xl bg-brand-blue/10 flex items-center justify-center text-brand-blue dark:text-brand-cyan transition-colors">
            <Sparkles class="w-5 h-5" />
          </div>
          <span class="text-brand-blue dark:text-brand-cyan font-black text-xs md:text-sm tracking-[0.3em] uppercase transition-colors">Contacto</span>
        </div>

        <h2 class="w-full whitespace-normal text-text-dark-titles dark:text-text-light-titles text-4xl md:text-5xl lg:text-6xl font-bold tracking-tighter leading-[1.05] transition-colors mb-4">
          ¿Listo para transformar tu negocio?
        </h2>

        <p class="w-full whitespace-normal text-text-dark dark:text-text-light text-lg md:text-xl leading-relaxed font-medium md:font-light transition-colors mb-8">
          Cuéntanos un poco sobre tu visión. Nos encantará ayudarte a encontrar la mejor ruta tecnológica para alcanzar tu éxito.
        </p>
      </div>

      <!-- Área dividida: viñetas (izq) y tarjetas de contacto (der) a la altura de las viñetas -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 items-start">
        <!-- Viñetas: ocupa 2 columnas en md+ -->
        <div class="md:col-span-2 flex flex-col gap-4 md:gap-5 min-w-0">
          {trustItems.map((item) => (
            <div class="contact-trust-item flex items-start gap-4 md:gap-5 text-text-dark-titles dark:text-white group transition-colors">
              <div class="w-6 h-6 md:w-7 md:h-7 rounded-full bg-brand-cyan/20 dark:bg-brand-blue/20 flex items-center justify-center text-brand-blue dark:text-brand-cyan shrink-0 mt-0.5 group-hover:bg-brand-blue group-hover:text-white transition-all duration-300">
                <CheckCircle2 class="w-4 h-4 md:w-5 md:h-5" />
              </div>
              <span class="text-lg md:text-xl font-medium text-text-dark dark:text-white/90 transition-colors">{item}</span>
            </div>
          ))}
        </div>

        <!-- Tarjetas de contacto: 1 columna en md+, alineadas al inicio de las viñetas -->
        <div class="md:col-span-1 w-full flex flex-col gap-4 justify-start self-start min-w-0">
          <a href={`mailto:${CONTACT_INFO.email}`}
             class="contact-card flex items-center gap-4 p-4 rounded-xl bg-light-surface/40 dark:bg-white/3 border border-light-border/40 dark:border-white/6 hover:bg-light-surface dark:hover:bg-white/6 transition-colors min-w-0 w-full">
            <div class="w-12 h-12 rounded-2xl bg-brand-blue/10 dark:bg-brand-cyan/10 flex items-center justify-center text-brand-blue dark:text-brand-cyan shrink-0">
              <Mail class="w-5 h-5 md:w-6 md:h-6" />
            </div>
            <div class="flex flex-col min-w-0">
              <span class="text-[10px] md:text-[11px] uppercase tracking-[0.18em] font-black text-text-dark dark:text-text-light">Email directo</span>
              <span class="text-base md:text-lg font-bold text-text-dark-titles dark:text-white truncate">{CONTACT_INFO.email}</span>
            </div>
          </a>

          <a href={WHATSAPP_URLS.contact} target="_blank" rel="noopener noreferrer"
             class="contact-card flex items-center gap-4 p-4 rounded-xl bg-light-surface/40 dark:bg-white/3 border border-light-border/40 dark:border-white/6 hover:bg-light-surface dark:hover:bg-white/6 transition-colors min-w-0 w-full">
            <div class="w-12 h-12 rounded-2xl bg-brand-cyan/20 dark:bg-brand-blue/12 flex items-center justify-center text-brand-blue dark:text-brand-cyan shrink-0">
              <Phone class="w-5 h-5 md:w-6 md:h-6" />
            </div>
            <div class="flex flex-col min-w-0">
              <span class="text-[10px] md:text-[11px] uppercase tracking-[0.18em] font-black text-text-dark dark:text-text-light">WhatsApp Business</span>
              <span class="text-base md:text-lg font-bold text-text-dark-titles dark:text-white truncate">+52 312 199 2198</span>
            </div>
          </a>
        </div>
      </div>

      <!-- Separador visual -->
      <div class="my-8 border-t border-light-border/40 dark:border-white/5"></div>

      <!-- Formulario (abajo) -->
      <div class="contact-form-wrapper w-full min-w-0">
        <div class="bg-light-surface/60 dark:bg-white/5 backdrop-blur-xl p-8 md:p-10 lg:p-14 rounded-2xl border border-light-border/50 dark:border-white/10 shadow-xl dark:shadow-2xl relative overflow-hidden transition-colors duration-500">
          <div class="absolute top-0 right-0 w-48 h-48 md:w-64 md:h-64 bg-brand-cyan/20 dark:bg-brand-cyan/10 blur-[80px] md:blur-[100px] -translate-y-1/2 translate-x-1/2 pointer-events-none transition-colors"></div>

          <form id="contact-form" class="flex flex-col gap-6 md:gap-8 relative z-10 min-w-0" novalidate>
            <!-- Banner de feedback / validación -->
            <div id="form-feedback" class="hidden p-4 rounded-xl text-center font-medium text-sm transition-all duration-300"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
              <div class="flex flex-col gap-2 min-w-0">
                <label for="name" class="text-[10px] md:text-[11px] font-black text-text-dark dark:text-text-light tracking-[0.2em] uppercase transition-colors">Tu Nombre</label>
                <input type="text" id="name" name="name" required placeholder="Ej. Juan Pérez"
                  class="w-full bg-light-base dark:bg-dark-base/50 border border-light-border dark:border-white/10 rounded-xl px-6 py-4 md:px-8 md:py-5 text-text-dark-titles dark:text-white text-base md:text-lg outline-none focus:border-brand-blue dark:focus:border-brand-cyan focus:ring-2 focus:ring-brand-blue/40 focus:shadow-[0_0_0_4px_rgba(68,102,255,0.1)] transition-all placeholder:text-text-dark/50 dark:placeholder:text-white/20 min-w-0" />
              </div>

              <div class="flex flex-col gap-2 min-w-0">
                <label for="email" class="text-[10px] md:text-[11px] font-black text-text-dark dark:text-text-light tracking-[0.2em] uppercase transition-colors">Correo Electrónico</label>
                <input type="email" id="email" name="email" required placeholder="juan@ejemplo.com"
                  class="w-full bg-light-base dark:bg-dark-base/50 border border-light-border dark:border-white/10 rounded-xl px-6 py-4 md:px-8 md:py-5 text-text-dark-titles dark:text-white text-base md:text-lg outline-none focus:border-brand-blue dark:focus:border-brand-cyan focus:ring-2 focus:ring-brand-blue/40 focus:shadow-[0_0_0_4px_rgba(68,102,255,0.1)] transition-all placeholder:text-text-dark/50 dark:placeholder:text-white/20 min-w-0" />
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
              <div class="flex flex-col gap-2 min-w-0">
                <label for="phone" class="text-[10px] md:text-[11px] font-black text-text-dark dark:text-text-light tracking-[0.2em] uppercase transition-colors">Teléfono / WhatsApp</label>
                <input type="tel" id="phone" name="phone" required placeholder="+52 312 000 0000"
                  class="w-full bg-light-base dark:bg-dark-base/50 border border-light-border dark:border-white/10 rounded-xl px-6 py-4 md:px-8 md:py-5 text-text-dark-titles dark:text-white text-base md:text-lg outline-none focus:border-brand-blue dark:focus:border-brand-cyan focus:ring-2 focus:ring-brand-blue/40 focus:shadow-[0_0_0_4px_rgba(68,102,255,0.1)] transition-all placeholder:text-text-dark/50 dark:placeholder:text-white/20 min-w-0" />
              </div>

              <div class="flex flex-col gap-2 min-w-0">
                <label for="business" class="text-[10px] md:text-[11px] font-black text-text-dark dark:text-text-light tracking-[0.2em] uppercase transition-colors">Nombre del Negocio</label>
                <input type="text" id="business" name="business" required placeholder="Mi Negocio Local"
                  class="w-full bg-light-base dark:bg-dark-base/50 border border-light-border dark:border-white/10 rounded-xl px-6 py-4 md:px-8 md:py-5 text-text-dark-titles dark:text-white text-base md:text-lg outline-none focus:border-brand-blue dark:focus:border-brand-cyan focus:ring-2 focus:ring-brand-blue/40 focus:shadow-[0_0_0_4px_rgba(68,102,255,0.1)] transition-all placeholder:text-text-dark/50 dark:placeholder:text-white/20 min-w-0" />
              </div>
            </div>

            <div class="flex flex-col gap-2 min-w-0">
              <label for="industry" class="text-[10px] md:text-[11px] font-black text-text-dark dark:text-text-light tracking-[0.2em] uppercase transition-colors">¿A qué se dedica tu negocio?</label>
              <input type="text" id="industry" name="industry" required placeholder="Ej. Restaurante, Clínica Dental, Taller..."
                class="w-full bg-light-base dark:bg-dark-base/50 border border-light-border dark:border-white/10 rounded-xl px-6 py-4 md:px-8 md:py-5 text-text-dark-titles dark:text-white text-base md:text-lg outline-none focus:border-brand-blue dark:focus:border-brand-cyan focus:ring-2 focus:ring-brand-blue/40 focus:shadow-[0_0_0_4px_rgba(68,102,255,0.1)] transition-all placeholder:text-text-dark/50 dark:placeholder:text-white/20 min-w-0" />
            </div>

            <div class="flex flex-col gap-2 min-w-0">
              <label for="message" class="text-[10px] md:text-[11px] font-black text-text-dark dark:text-text-light tracking-[0.2em] uppercase transition-colors">Cuéntanos sobre tu problemática</label>
              <textarea id="message" name="message" rows="4" placeholder="Hola, me gustaría digitalizar mis pedidos..."
                class="w-full bg-light-base dark:bg-dark-base/50 border border-light-border dark:border-white/10 rounded-xl px-6 py-4 md:px-8 md:py-5 text-text-dark-titles dark:text-white text-base md:text-lg outline-none focus:border-brand-blue dark:focus:border-brand-cyan focus:ring-2 focus:ring-brand-blue/40 focus:shadow-[0_0_0_4px_rgba(68,102,255,0.1)] transition-all resize-none placeholder:text-text-dark/50 dark:placeholder:text-white/20 min-w-0"></textarea>
            </div>

            <div class="pt-2 md:pt-4">
              <Button variant="primary" size="hero" type="submit" class="w-full group/sub" id="submit-btn">
                <span class="font-black uppercase tracking-[0.2em] md:tracking-[0.3em] text-xs md:text-sm">Agendar Asesoría Gratuita</span>
                <Sparkles class="ml-2 md:ml-3 w-4 h-4 md:w-5 md:h-5 group-hover/sub:scale-125 transition-transform" />
              </Button>
              <p class="text-center text-text-dark dark:text-text-light text-xs md:text-sm mt-4 md:mt-6 font-medium italic transition-colors">Al enviar, serás redirigido a WhatsApp para una atención inmediata.</p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </Section>
</contact-section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  class ContactSection extends HTMLElement {
    form: HTMLFormElement | null = null;
    submitHandler: ((e: Event) => void) | null = null;
    ctx: gsap.Context | null = null;

    connectedCallback() {
      // Entrance animations
      this.ctx = gsap.context(() => {
        const tl = gsap.timeline({
          scrollTrigger: { trigger: '#contacto', start: 'top 80%' },
          defaults: { ease: 'power3.out' },
        });

        tl.fromTo('.contact-header > *', { y: 30, opacity: 0 }, { y: 0, opacity: 1, stagger: 0.12, duration: 0.8 })
          .fromTo('.contact-trust-item', { x: -30, opacity: 0 }, { x: 0, opacity: 1, stagger: 0.1, duration: 0.6 }, '-=0.4')
          .fromTo('.contact-card', { x: 30, opacity: 0 }, { x: 0, opacity: 1, stagger: 0.15, duration: 0.6 }, '<')
          .fromTo('.contact-form-wrapper', { scale: 0.95, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.9, ease: 'expo.out' }, '-=0.3');
      }, this);

      this.form = this.querySelector('#contact-form');
      const feedback = this.querySelector('#form-feedback') as HTMLElement;
      if (!this.form) return;

      this.submitHandler = (e: Event) => {
        e.preventDefault();
        if (!this.form) return;

        const formData = new FormData(this.form);
        const data = Object.fromEntries(formData.entries()) as Record<string, string>;

        const showFeedback = (msg: string, isError: boolean) => {
          if (!feedback) return;
          feedback.textContent = msg;
          feedback.className = `p-4 rounded-xl text-center font-medium text-sm transition-all duration-300 ${
            isError 
              ? 'bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/20 block'
              : 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 block'
          }`;
        };
        
        // Client-side validation
        if (!data.name?.trim()) {
          showFeedback('Por favor ingresa tu nombre.', true);
          return;
        }

        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!data.email || !emailRegex.test(data.email.toString())) {
          showFeedback('Por favor ingresa un correo electrónico válido.', true);
          return;
        }

        const cleanPhone = (data.phone || '').toString().replace(/\D/g, '');
        if (cleanPhone.length < 7) {
          showFeedback('Por favor ingresa un número de teléfono válido (mínimo 7 dígitos).', true);
          return;
        }

        if (!data.business?.trim()) {
          showFeedback('Por favor ingresa el nombre de tu negocio.', true);
          return;
        }

        showFeedback('¡Información validada! Redirigiendo a WhatsApp...', false);

        // Create Structured WhatsApp Message
        const text = `✅ SOLICITUD DE ASESORÍA NOVORY\n\n` +
                     `👤 Nombre: ${data.name}\n` +
                     `🏪 Negocio: ${data.business}\n` +
                     `💼 Giro: ${data.industry || 'No especificado'}\n` +
                     `📧 Email: ${data.email}\n` +
                     `📞 Teléfono: ${data.phone}\n\n` +
                     `💬 Problemática: ${data.message || 'Sin mensaje'}`;
                     
        const encodedText = encodeURIComponent(text);
        const whatsappUrl = `https://api.whatsapp.com/send?phone=523121992198&text=${encodedText}`;

        setTimeout(() => {
          window.open(whatsappUrl, '_blank');
        }, 400);
      };

      this.form.addEventListener('submit', this.submitHandler);
    }

    disconnectedCallback() {
      if (this.form && this.submitHandler) {
        this.form.removeEventListener('submit', this.submitHandler);
      }
      this.form = null;
      this.submitHandler = null;
      if (this.ctx) { this.ctx.revert(); this.ctx = null; }
    }
  }

  if (!customElements.get('contact-section')) {
    customElements.define('contact-section', ContactSection);
  }
</script>
