---
import Section from "../layout/Section.astro";
import Card from "../molecules/Card.astro";
import { Heart, Target, Lightbulb, Zap, Shield, Users } from "@lucide/astro";

const values = [
  { icon: Target, title: "Resultados reales" },
  { icon: Lightbulb, title: "Innovación" },
  { icon: Heart, title: "Compromiso" },
  { icon: Shield, title: "Transparencia" },
  { icon: Zap, title: "Calidad extrema" },
  { icon: Users, title: "Cercanía" },
];
---

<about-section class="block">
  <Section
    id="nosotros"
    class="bg-light-base dark:bg-dark-base relative overflow-hidden"
  >
    <div
      class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-brand-blue/5 dark:bg-brand-blue/10 blur-[100px] md:blur-[150px] rounded-full pointer-events-none transition-colors duration-700"
    >
    </div>

    <div
      class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16 lg:gap-24 items-stretch relative z-10"
    >
      <!-- Left -->
      <div
        class="flex flex-col gap-8 md:gap-10 about-content min-w-0 min-h-0 shrink"
      >
        <div class="flex items-center gap-3">
          <div class="w-10 h-0.5 bg-brand-blue dark:bg-brand-cyan"></div>
          <span
            class="text-brand-blue dark:text-brand-cyan font-black text-xs md:text-sm tracking-[0.3em] uppercase"
            >Nuestra Misión</span
          >
        </div>

        <h2
          class="text-text-dark-titles dark:text-text-light-titles text-4xl md:text-6xl lg:text-6xl font-bold tracking-tighter leading-[1.1] transition-colors"
        >
          ¿Por qué existe Novory?
        </h2>

        <div
          class="flex flex-col gap-6 md:gap-8 text-text-dark dark:text-text-light text-base md:text-lg lg:text-xl leading-relaxed max-w-2xl transition-colors"
        >
          <p>
            Durante años vimos cómo muchos negocios locales tenían productos y
            servicios de excelencia, pero su presencia digital no reflejaba esa
            misma calidad.
          </p>
          <p>
            Muchos dependían exclusivamente de redes sociales volátiles, otros
            perdían clientes por procesos manuales lentos, y la mayoría
            simplemente no sabía por dónde empezar.
          </p>
          <p>
            <span class="text-brand-blue dark:text-brand-cyan font-bold"
              >Novory nació para cerrar esa brecha.</span
            > Creemos que la tecnología de alto nivel no debe ser un privilegio de
            grandes corporaciones, sino una herramienta para que los negocios locales
            prosperen.
          </p>
        </div>

        <div
          class="magnetic-element relative inline-flex flex-col gap-2 p-6 border-l-4 border-brand-blue dark:border-brand-cyan bg-light-surface/40 dark:bg-white/5 backdrop-blur-md rounded-r-2xl transition-all duration-500 hover:bg-light-surface/80 dark:hover:bg-white/10 hover:shadow-[0_8px_30px_rgba(68,102,255,0.12)] dark:hover:shadow-[0_8px_30px_rgba(0,240,255,0.08)] group/manifesto overflow-hidden cursor-default"
        >
          <div class="absolute inset-0 bg-linear-to-r from-transparent via-brand-blue/10 dark:via-brand-cyan/10 to-transparent -translate-x-[150%] group-hover/manifesto:animate-shimmer pointer-events-none"></div>
          <p
            class="relative z-10 text-text-dark-titles dark:text-white font-medium italic text-lg md:text-xl leading-relaxed transition-colors group-hover/manifesto:text-brand-blue dark:group-hover/manifesto:text-white duration-300"
          >
            "Diseñamos herramientas que ayudan a las personas a trabajar mejor,
            ahorrar tiempo y hacer crecer sus sueños."
          </p>
        </div>
      </div>

      <!-- Right -->
      <div
        class="flex flex-col gap-8 md:gap-10 about-visual min-w-0 min-h-0 shrink"
      >
        <!-- Card: controlar overflow interno y usar aspect ratio compatible -->
        <Card
          class="p-0 border-light-border/50 dark:border-white/10 group/founder shadow-xl dark:shadow-2xl"
        >
          <div
            class="aspect-w-4 aspect-h-3 bg-light-surface dark:bg-dark-surface flex items-center justify-center text-brand-blue/20 dark:text-brand-cyan/10 relative overflow-hidden transition-colors min-h-0 min-w-0"
          >
            <Users
              class="w-24 h-24 md:w-32 md:h-32 group-hover/founder:scale-110 transition-transform duration-1000"
              stroke-width="0.3"
            />
            <div
              class="absolute inset-0 bg-linear-to-t from-light-base via-transparent to-transparent dark:from-dark-base opacity-90 transition-colors pointer-events-none"
            >
            </div>
            <div
              class="absolute bottom-6 right-6 px-4 py-2 bg-light-surface/80 dark:bg-dark-surface/80 backdrop-blur-md border border-light-border/50 dark:border-brand-cyan/20 rounded-full transition-colors"
            >
              <span
                class="text-[10px] text-brand-blue dark:text-brand-cyan font-black tracking-widest uppercase"
                >Est. 2026</span
              >
            </div>
          </div>

          <div
            class="p-8 md:p-10 flex flex-col gap-3 bg-light-base dark:bg-transparent transition-colors min-h-0 overflow-auto"
          >
            <h3
              class="text-2xl md:text-3xl font-bold text-text-dark-titles dark:text-white tracking-tight transition-colors"
            >
              Cercanía y Capacidad
            </h3>
            <p
              class="text-text-dark dark:text-text-light text-sm md:text-base leading-relaxed transition-colors"
            >
              No somos una corporación distante. Somos un equipo apasionado
              obsesionado con la excelencia técnica y humana.
            </p>
          </div>
        </Card>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 md:gap-4">
          {
            values.map((value) => (
              <div class="magnetic-element relative flex items-center gap-4 p-4 md:p-5 rounded-lg bg-light-surface/30 dark:bg-white/5 backdrop-blur-sm border border-light-border/40 dark:border-white/10 hover:bg-light-surface/90 dark:hover:bg-white/10 hover:border-brand-blue/40 dark:hover:border-brand-cyan/40 transition-all duration-500 hover:shadow-lg hover:shadow-brand-blue/5 dark:hover:shadow-brand-cyan/10 group/value min-w-0 overflow-hidden cursor-default">
                <div class="absolute inset-0 bg-linear-to-tr from-brand-blue/0 via-brand-blue/5 to-brand-blue/0 dark:from-brand-cyan/0 dark:via-brand-cyan/10 dark:to-brand-cyan/0 opacity-0 group-hover/value:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
                <div class="relative z-10 w-10 h-10 shrink-0 rounded-xl bg-brand-blue/10 dark:bg-white/5 flex items-center justify-center text-brand-blue/70 dark:text-white/50 group-hover/value:text-white dark:group-hover/value:text-dark-base group-hover/value:bg-brand-blue dark:group-hover/value:bg-brand-cyan group-hover/value:scale-110 group-hover/value:shadow-[0_0_15px_rgba(68,102,255,0.4)] dark:group-hover/value:shadow-[0_0_15px_rgba(0,240,255,0.4)] transition-all duration-300">
                  <value.icon class="w-5 h-5" />
                </div>
                <span class="relative z-10 text-sm md:text-base font-bold text-text-dark-titles dark:text-white/80 group-hover/value:text-brand-blue dark:group-hover/value:text-white transition-colors duration-300">
                  {value.title}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </Section>
</about-section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  class AboutSection extends HTMLElement {
    ctx: gsap.Context | null = null;
    magneticElements: HTMLElement[] = [];
    magneticHandlers: {el: HTMLElement, move: (e: MouseEvent) => void, leave: () => void}[] = [];

    connectedCallback() {
      this.ctx = gsap.context(() => {
        gsap.fromTo(
          ".about-visual",
          { y: 40, opacity: 0 },
          {
            scrollTrigger: {
              trigger: "#nosotros",
              start: "top 85%",
            },
            opacity: 1,
            y: 0,
            duration: 1.5,
            ease: "power4.out",
          },
        );

        gsap.from(".about-content > *", {
          scrollTrigger: {
            trigger: "#nosotros",
            start: "top 85%",
          },
          opacity: 0,
          y: 40,
          stagger: 0.15,
          duration: 1.2,
          ease: "power3.out",
        });
      }, this);

      // Magnetic effect setup
      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        this.magneticElements = Array.from(this.querySelectorAll('.magnetic-element'));
        
        this.magneticElements.forEach(el => {
          const move = (e: MouseEvent) => {
            const rect = el.getBoundingClientRect();
            const x = e.clientX - rect.left - rect.width / 2;
            const y = e.clientY - rect.top - rect.height / 2;
            
            // Subtle movement - adjust the divisor for stronger/weaker effect (higher = weaker)
            gsap.to(el, {
              x: x / 25,
              y: y / 25,
              duration: 0.3,
              ease: "power2.out"
            });
          };
          
          const leave = () => {
            gsap.to(el, {
              x: 0,
              y: 0,
              duration: 0.6,
              ease: "elastic.out(1, 0.3)"
            });
          };

          el.addEventListener('mousemove', move);
          el.addEventListener('mouseleave', leave);
          this.magneticHandlers.push({ el, move, leave });
        });
      }
    }

    disconnectedCallback() {
      if (this.ctx) {
        this.ctx.revert();
        this.ctx = null;
      }
      
      this.magneticHandlers.forEach(({el, move, leave}) => {
        el.removeEventListener('mousemove', move);
        el.removeEventListener('mouseleave', leave);
      });
      this.magneticHandlers = [];
    }
  }

  if (!customElements.get("about-section")) {
    customElements.define("about-section", AboutSection);
  }
</script>

<style>
  @keyframes shimmer {
    0% {
      transform: translateX(-150%);
    }
    100% {
      transform: translateX(150%);
    }
  }
  .animate-shimmer {
    animation: shimmer 1.5s infinite;
  }
</style>
