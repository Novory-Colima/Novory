---
import Section from '../layout/Section.astro';
import Card from '../molecules/Card.astro';
import { Users, Clock, ShieldCheck, Eye, Zap, TrendingUp } from '@lucide/astro';

const benefits = [
  {
    title: 'Más clientes.',
    description: 'Convierte visitantes en oportunidades reales mediante una presencia digital profesional diseñada para vender.',
    icon: Users,
  },
  {
    title: 'Más tiempo.',
    description: 'Automatiza tareas repetitivas y administrativas para dedicarte a lo que realmente importa: tu negocio.',
    icon: Clock,
  },
  {
    title: 'Mayor confianza.',
    description: 'Una imagen profesional y moderna transmite seguridad a tus prospectos antes del primer contacto.',
    icon: ShieldCheck,
  },
  {
    title: 'Más visibilidad.',
    description: 'Aparece de forma destacada donde tus clientes locales están buscando activamente tus servicios hoy.',
    icon: Eye,
  },
  {
    title: 'Procesos inteligentes.',
    description: 'Menos errores, menos tareas manuales y mucha más eficiencia operativa en tu día a día.',
    icon: Zap,
  },
  {
    title: 'Crecimiento continuo.',
    description: 'Tu ecosistema digital evolucionará y escalará junto con las metas y necesidades de tu empresa.',
    icon: TrendingUp,
  },
];
---

<Section id="beneficios" class="bg-bg-primary relative overflow-hidden">
  <!-- Decorative ecosystem lines -->
  <div class="absolute inset-0 pointer-events-none">
    <svg class="w-full h-full opacity-[0.03]" viewBox="0 0 1200 800" fill="none">
      <path d="M100,100 Q400,50 600,400 T1100,700" stroke="var(--color-accent)" stroke-width="2" stroke-dasharray="8 8" />
      <path d="M1100,100 Q800,300 600,100 T100,700" stroke="var(--color-accent-glow)" stroke-width="2" stroke-dasharray="8 8" />
      <circle cx="200" cy="200" r="4" fill="var(--color-accent)" />
      <circle cx="600" cy="400" r="6" fill="var(--color-accent)" />
      <circle cx="1000" cy="600" r="4" fill="var(--color-accent)" />
    </svg>
  </div>

  <!-- Background glow -->
  <div class="absolute bottom-0 right-0 w-[800px] h-[800px] bg-accent/5 blur-[200px] rounded-full translate-y-1/2 translate-x-1/2 pointer-events-none"></div>

  <div class="max-w-4xl mx-auto text-center mb-24 flex flex-col gap-6 section-header relative z-10">
    <h2 class="text-white">Mucho más que un sitio web.</h2>
    <p class="text-text-secondary text-lg md:text-xl leading-relaxed">
      Creamos un ecosistema digital diseñado para ayudarte a vender más, <br class="hidden md:block" /> ahorrar tiempo y ofrecer una experiencia superior a tus clientes.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 benefits-grid relative z-10">
    {benefits.map((benefit) => (
      <Card class="p-12 flex flex-col gap-8 bg-white/[0.01] border-white/5 hover:border-accent/40 group overflow-visible">
        <div class="w-16 h-16 rounded-2xl bg-accent/10 flex items-center justify-center text-accent group-hover:bg-accent group-hover:text-white group-hover:shadow-glow transition-all duration-500 ease-standard">
          <benefit.icon class="w-8 h-8" />
        </div>
        <div class="flex flex-col gap-4">
          <h3 class="text-2xl md:text-3xl font-bold text-white tracking-tight leading-tight">{benefit.title}</h3>
          <p class="text-text-secondary text-base md:text-lg leading-relaxed">
            {benefit.description}
          </p>
        </div>
      </Card>
    ))}
  </div>
</Section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initBenefits() {
    gsap.from('.benefits-grid > div', {
      scrollTrigger: {
        trigger: '.benefits-grid',
        start: 'top 85%',
      },
      y: 60,
      opacity: 0,
      duration: 1.2,
      stagger: 0.12,
      ease: 'power4.out',
    });
  }

  window.addEventListener('load', initBenefits);
  document.addEventListener('astro:page-load', initBenefits);
</script>
