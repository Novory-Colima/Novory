---
import Section from '../layout/Section.astro';
import Button from '../atoms/Button.astro';
import HeroVisual from '../ui/HeroVisual.astro';
import { Check } from '@lucide/astro';

const trustIndicators = [
  'Sitios rápidos',
  'SEO Local',
  'Automatización',
  'Atención personalizada'
];
---

<Section class="min-h-screen flex items-center pt-32 pb-20">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
    <!-- Left Column: Content -->
    <div class="lg:col-span-7 flex flex-col gap-8 hero-content">
      <h1 class="text-white leading-[1.1] tracking-tighter">
        Transformamos negocios locales <br />
        <span class="text-gradient">en negocios digitales.</span>
      </h1>
      
      <p class="text-text-secondary text-xl md:text-2xl max-w-2xl leading-relaxed font-light">
        Creamos sitios web modernos, optimizados para Google y automatizados para ayudarte a conseguir más clientes mientras ahorras tiempo en tu operación diaria.
      </p>

      <div class="flex flex-col sm:flex-row items-center gap-6 mt-4">
        <Button variant="primary" size="hero" href="/contacto" class="w-full sm:w-auto">
          Agenda una asesoría
        </Button>
        <Button variant="secondary" size="hero" href="/portafolio" class="w-full sm:w-auto">
          Ver proyectos
        </Button>
      </div>

      <!-- Trust Indicators -->
      <div class="flex flex-wrap items-center gap-x-10 gap-y-5 mt-8 border-t border-white/5 pt-8">
        {trustIndicators.map((item) => (
          <div class="flex items-center gap-3 text-sm font-bold text-white/60 tracking-wider uppercase">
            <div class="w-5 h-5 rounded-full bg-accent/20 flex items-center justify-center text-accent">
               <Check class="w-3.5 h-3.5" />
            </div>
            <span>{item}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Right Column: Visual -->
    <div class="lg:col-span-5 relative hero-visual opacity-0 scale-95">
      <HeroVisual />
    </div>
  </div>
</Section>

<script>
  import { gsap } from 'gsap';

  function initHero() {
    const tl = gsap.timeline({ defaults: { ease: 'power4.out', duration: 1.2 } });

    tl.from('.hero-content h1', { y: 40, opacity: 0, delay: 0.3 })
      .from('.hero-content p', { y: 30, opacity: 0 }, '-=0.9')
      .from('.hero-content .flex', { y: 20, opacity: 0 }, '-=0.9')
      .from('.hero-content .flex-wrap', { opacity: 0 }, '-=0.8')
      .to('.hero-visual', { scale: 1, opacity: 1, duration: 1.8, ease: 'expo.out' }, '-=1.2');
  }

  window.addEventListener('load', initHero);
  document.addEventListener('astro:page-load', initHero);
</script>
