---
import Section from '../layout/Section.astro';
import Button from '../atoms/Button.astro';
import HeroVisual from '../ui/HeroVisual.astro';
import { Check } from '@lucide/astro';

const trustIndicators = [
  'Sitios rápidos',
  'SEO Local',
  'Automatización',
  'Atención personalizada'
];
---

<Section class="bg-light-base dark:bg-bg-primary min-h-screen flex items-center pt-28 md:pt-32 pb-16 md:pb-20 transition-colors duration-500 overflow-hidden relative">
  
  <!-- Resplandor de fondo adaptativo -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-75 md:w-150 h-75 md:h-150 bg-brand-blue/10 dark:bg-brand-blue/5 blur-[100px] md:blur-[150px] rounded-full pointer-events-none transition-colors duration-700"></div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center relative z-10">
    <!-- Left Column: Content -->
    <div class="lg:col-span-7 flex flex-col gap-6 md:gap-8 hero-content">
      <h1 class="text-text-dark-titles dark:text-white text-5xl md:text-6xl lg:text-7xl font-bold leading-[1.1] tracking-tighter transition-colors">
        Transformamos negocios locales <br />
        <span class="bg-clip-text text-transparent bg-linear-to-r from-brand-cyan via-brand-blue to-brand-purple">en negocios digitales.</span>
      </h1>
      
      <p class="text-text-dark dark:text-text-secondary text-lg md:text-xl lg:text-2xl max-w-2xl leading-relaxed font-medium md:font-light transition-colors">
        Creamos sitios web modernos, optimizados para Google y automatizados para ayudarte a conseguir más clientes mientras ahorras tiempo en tu operación diaria.
      </p>

      <div class="flex flex-col sm:flex-row items-center gap-4 md:gap-6 mt-2 md:mt-4">
        <Button variant="primary" size="hero" href="/contacto" class="w-full sm:w-auto">
          Agenda una asesoría
        </Button>
        <Button variant="secondary" size="hero" href="/portafolio" class="w-full sm:w-auto">
          Ver proyectos
        </Button>
      </div>

      <!-- Trust Indicators -->
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-x-6 md:gap-x-10 gap-y-4 md:gap-y-5 mt-6 md:mt-8 border-t border-light-border/50 dark:border-white/5 pt-6 md:pt-8 transition-colors">
        {trustIndicators.map((item) => (
          <div class="flex items-center gap-2 md:gap-3 text-xs md:text-sm font-bold text-text-dark dark:text-white/60 tracking-wider uppercase transition-colors">
            <div class="w-4 h-4 md:w-5 md:h-5 rounded-full bg-brand-cyan/20 dark:bg-brand-blue/20 flex items-center justify-center text-brand-blue dark:text-brand-cyan transition-colors">
               <Check class="w-3 h-3 md:w-3.5 md:h-3.5" />
            </div>
            <span>{item}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Right Column: Visual -->
    <div class="lg:col-span-5 relative hero-visual opacity-0 scale-95 mt-10 lg:mt-0">
      <HeroVisual />
    </div>
  </div>
</Section>

<script>
  import { gsap } from 'gsap';

  function initHero() {
    const tl = gsap.timeline({ defaults: { ease: 'power4.out', duration: 1.2 } });

    tl.from('.hero-content h1', { y: 40, opacity: 0, delay: 0.3 })
      .from('.hero-content p', { y: 30, opacity: 0 }, '-=0.9')
      .from('.hero-content .flex', { y: 20, opacity: 0 }, '-=0.9')
      .from('.hero-content .flex-wrap', { opacity: 0 }, '-=0.8')
      .to('.hero-visual', { scale: 1, opacity: 1, duration: 1.8, ease: 'expo.out' }, '-=1.2');
  }

  window.addEventListener('load', initHero);
  document.addEventListener('astro:page-load', initHero);
</script>
