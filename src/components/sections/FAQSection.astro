---
import Section from '../layout/Section.astro';
import { ChevronDown, HelpCircle } from '@lucide/astro';

const faqs = [
  {
    question: '¿Cuánto tiempo tarda un proyecto?',
    answer: 'Dependerá del alcance y la complejidad. Antes de comenzar definiremos un calendario claro con hitos específicos para que conozcas cada etapa del proceso.',
  },
  {
    question: '¿Necesito tener conocimientos técnicos?',
    answer: 'No. En Novory nos encargamos de toda la complejidad técnica para que tú puedas concentrarte al 100% en operar y hacer crecer tu negocio.',
  },
  {
    question: '¿Pueden ayudarme si ya tengo una página web?',
    answer: 'Sí. Podemos realizar una auditoría de tu sitio actual para optimizarlo, o desarrollar una nueva estrategia desde cero si los cimientos actuales no son sólidos.',
  },
  {
    question: '¿También ayudan con Google y SEO?',
    answer: 'Por supuesto. La visibilidad es clave. Cada proyecto se desarrolla considerando las mejores prácticas de SEO y posicionamiento local desde la primera línea de código.',
  },
  {
    question: '¿Las automatizaciones funcionan con WhatsApp?',
    answer: 'Sí. Implementamos sistemas automatizados inteligentes que ayudan a calificar prospectos, responder dudas frecuentes y organizar tu flujo de trabajo vía WhatsApp.',
  },
  {
    question: '¿Mi negocio es demasiado pequeño para esto?',
    answer: 'En absoluto. Trabajamos precisamente con negocios locales de todos los tamaños que tienen la ambición de profesionalizarse y escalar utilizando tecnología.',
  },
  {
    question: '¿Después del lanzamiento ofrecen soporte?',
    answer: 'Sí. No somos una agencia de "entrega y adiós". Buscamos construir relaciones a largo plazo y acompañarte en la evolución continua de tu presencia digital.',
  },
];
---

<faq-section class="block">
  <Section id="faq" class="bg-light-surface/30 dark:bg-bg-primary relative overflow-hidden transition-colors duration-500">
    <!-- Subtle background glow -->
    <div class="absolute left-1/2 bottom-0 -translate-x-1/2 w-full h-75 md:h-125 bg-brand-blue/10 dark:bg-brand-blue/3 blur-[100px] md:blur-[150px] rounded-full pointer-events-none transition-colors"></div>

    <div class="max-w-3xl mx-auto text-center mb-16 md:mb-24 flex flex-col gap-6 md:gap-8 relative z-10 px-4">
      <div class="flex items-center justify-center gap-3 mb-1 md:mb-2">
         <div class="w-10 h-10 md:w-12 md:h-12 rounded-2xl bg-brand-cyan/20 dark:bg-brand-blue/10 flex items-center justify-center text-brand-blue dark:text-brand-cyan transition-colors">
            <HelpCircle class="w-5 h-5 md:w-6 md:h-6" />
         </div>
      </div>
      <h2 class="text-text-dark-titles dark:text-white text-4xl md:text-5xl lg:text-6xl font-bold tracking-tighter leading-tight transition-colors">Preguntas Frecuentes</h2>
      <p class="text-text-dark dark:text-text-secondary text-lg md:text-xl lg:text-2xl leading-relaxed font-medium md:font-light transition-colors">
        Respondemos las dudas que probablemente también tienes <br class="hidden md:block" /> antes de iniciar tu transformación digital.
      </p>
    </div>

    <div class="max-w-4xl mx-auto flex flex-col gap-4 md:gap-5 relative z-10 px-4 md:px-0">
      {faqs.map((faq, index) => (
        <div class="faq-item bg-light-base/60 dark:bg-white/1 backdrop-blur-md border border-light-border/50 dark:border-white/5 hover:bg-light-surface dark:hover:bg-white/2 hover:border-brand-blue/30 dark:hover:border-white/10 transition-all duration-500 group rounded-3xl shadow-sm dark:shadow-none">
          <button class="w-full flex items-center justify-between p-6 md:p-8 lg:p-10 text-left cursor-pointer faq-trigger outline-none focus-visible:ring-2 focus-visible:ring-brand-blue/50 rounded-3xl" aria-expanded="false">
            <span class="text-lg md:text-xl lg:text-2xl font-bold text-text-dark-titles dark:text-white pr-6 md:pr-10 group-hover:text-brand-blue dark:group-hover:text-brand-cyan transition-colors duration-300 tracking-tight leading-snug">
              {faq.question}
            </span>
            <div class="w-10 h-10 md:w-12 md:h-12 rounded-full border border-light-border dark:border-white/5 flex items-center justify-center group-hover:border-brand-blue/30 dark:group-hover:border-brand-cyan/30 transition-all duration-500 shrink-0 bg-light-surface/50 dark:bg-transparent">
               <ChevronDown class="w-5 h-5 md:w-6 md:h-6 text-text-dark dark:text-text-secondary group-hover:text-brand-blue dark:group-hover:text-brand-cyan transition-all duration-500 transform faq-icon" />
            </div>
          </button>
          <div class="faq-content overflow-hidden max-h-0 transition-all duration-500 ease-in-out">
            <div class="px-6 md:px-8 lg:px-10 pb-8 md:pb-10 border-t border-light-border/30 dark:border-white/2 pt-6 md:pt-8">
              <p class="text-text-dark dark:text-text-secondary text-base md:text-lg lg:text-xl leading-relaxed max-w-3xl transition-colors">
                {faq.answer}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-20 md:mt-28 text-center px-4">
       <div class="p-6 md:p-8 bg-light-base/80 dark:bg-white/1 backdrop-blur-md border border-light-border/50 dark:border-white/5 inline-flex flex-col md:flex-row items-center gap-4 md:gap-6 rounded-[24px] md:rounded-4xl shadow-sm dark:shadow-none transition-colors">
          <p class="text-text-dark-titles dark:text-white font-medium text-sm md:text-base transition-colors">¿Tienes alguna otra duda específica?</p>
          <a href="/#contacto" class="text-brand-blue dark:text-brand-cyan font-bold hover:underline underline-offset-4 decoration-2 text-sm md:text-base transition-colors">Contáctanos directamente →</a>
       </div>
    </div>
  </Section>
</faq-section>

<script>
  class FAQSection extends HTMLElement {
    cleanupFns: Function[] = [];

    connectedCallback() {
      const faqItems = this.querySelectorAll('.faq-item');
      
      faqItems.forEach(item => {
        const trigger = item.querySelector('.faq-trigger');
        const content = item.querySelector('.faq-content') as HTMLElement;
        const icon = item.querySelector('.faq-icon');

        if (!trigger || !content) return;

        const handler = () => {
          const isOpen = trigger.getAttribute('aria-expanded') === 'true';
          
          // Close all other items for exclusive behavior
          faqItems.forEach(otherItem => {
            if (otherItem !== item) {
              const otherTrigger = otherItem.querySelector('.faq-trigger');
              const otherContent = otherItem.querySelector('.faq-content') as HTMLElement;
              const otherIcon = otherItem.querySelector('.faq-icon');
              
              otherTrigger?.setAttribute('aria-expanded', 'false');
              if (otherContent) otherContent.style.maxHeight = '0';
              otherIcon?.classList.remove('rotate-180');
            }
          });

          // Toggle current item
          trigger.setAttribute('aria-expanded', !isOpen ? 'true' : 'false');
          content.style.maxHeight = !isOpen ? `${content.scrollHeight}px` : '0';
          icon?.classList.toggle('rotate-180', !isOpen);
        };

        trigger.addEventListener('click', handler);
        this.cleanupFns.push(() => trigger.removeEventListener('click', handler));
      });
    }

    disconnectedCallback() {
      this.cleanupFns.forEach(fn => fn());
      this.cleanupFns = [];
    }
  }

  if (!customElements.get('faq-section')) {
    customElements.define('faq-section', FAQSection);
  }
</script>