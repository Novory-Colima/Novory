---
import Section from '../layout/Section.astro';
import { ChevronDown, HelpCircle } from '@lucide/astro';

const faqs = [
  {
    question: '¿Cuánto tiempo tarda un proyecto?',
    answer: 'Dependerá del alcance y la complejidad. Antes de comenzar definiremos un calendario claro con hitos específicos para que conozcas cada etapa del proceso.',
  },
  {
    question: '¿Necesito tener conocimientos técnicos?',
    answer: 'No. En Novory nos encargamos de toda la complejidad técnica para que tú puedas concentrarte al 100% en operar y hacer crecer tu negocio.',
  },
  {
    question: '¿Pueden ayudarme si ya tengo una página web?',
    answer: 'Sí. Podemos realizar una auditoría de tu sitio actual para optimizarlo, o desarrollar una nueva estrategia desde cero si los cimientos actuales no son sólidos.',
  },
  {
    question: '¿También ayudan con Google y SEO?',
    answer: 'Por supuesto. La visibilidad es clave. Cada proyecto se desarrolla considerando las mejores prácticas de SEO y posicionamiento local desde la primera línea de código.',
  },
  {
    question: '¿Las automatizaciones funcionan con WhatsApp?',
    answer: 'Sí. Implementamos sistemas automatizados inteligentes que ayudan a calificar prospectos, responder dudas frecuentes y organizar tu flujo de trabajo vía WhatsApp.',
  },
  {
    question: '¿Mi negocio es demasiado pequeño para esto?',
    answer: 'En absoluto. Trabajamos precisamente con negocios locales de todos los tamaños que tienen la ambición de profesionalizarse y escalar utilizando tecnología.',
  },
  {
    question: '¿Después del lanzamiento ofrecen soporte?',
    answer: 'Sí. No somos una agencia de "entrega y adiós". Buscamos construir relaciones a largo plazo y acompañarte en la evolución continua de tu presencia digital.',
  },
];
---

<Section id="faq" class="bg-bg-primary relative overflow-hidden">
  <!-- Subtle background glow -->
  <div class="absolute left-1/2 bottom-0 -translate-x-1/2 w-full h-[500px] bg-accent/[0.03] blur-[150px] rounded-full pointer-events-none"></div>

  <div class="max-w-3xl mx-auto text-center mb-24 flex flex-col gap-8 relative z-10">
    <div class="flex items-center justify-center gap-3 mb-2">
       <div class="w-12 h-12 rounded-2xl bg-accent/10 flex items-center justify-center text-accent">
          <HelpCircle class="w-6 h-6" />
       </div>
    </div>
    <h2 class="text-white text-5xl md:text-6xl font-bold tracking-tighter leading-tight">Preguntas Frecuentes</h2>
    <p class="text-text-secondary text-xl md:text-2xl leading-relaxed font-light">
      Respondemos las dudas que probablemente también tienes <br class="hidden md:block" /> antes de iniciar tu transformación digital.
    </p>
  </div>

  <div class="max-w-4xl mx-auto flex flex-col gap-5 relative z-10">
    {faqs.map((faq, index) => (
      <div class="faq-item glass-panel border-white/5 bg-white/[0.01] hover:bg-white/[0.02] hover:border-white/10 transition-all duration-500 group">
        <button class="w-full flex items-center justify-between p-8 md:p-10 text-left cursor-pointer faq-trigger outline-none focus-visible:ring-1 focus-visible:ring-accent/50 rounded-3xl" aria-expanded="false">
          <span class="text-xl md:text-2xl font-bold text-white pr-10 group-hover:text-accent transition-colors duration-300 tracking-tight leading-snug">
            {faq.question}
          </span>
          <div class="w-12 h-12 rounded-full border border-white/5 flex items-center justify-center group-hover:border-accent/30 transition-all duration-500 shrink-0">
             <ChevronDown class="w-6 h-6 text-text-secondary group-hover:text-accent transition-all duration-500 transform faq-icon" />
          </div>
        </button>
        <div class="faq-content overflow-hidden max-h-0 transition-all duration-500 ease-in-out">
          <div class="px-8 md:px-10 pb-10 border-t border-white/[0.02] pt-8">
            <p class="text-text-secondary text-lg md:text-xl leading-relaxed max-w-3xl">
              {faq.answer}
            </p>
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="mt-28 text-center">
     <div class="p-8 glass-panel border-white/5 bg-white/[0.01] inline-flex flex-col md:flex-row items-center gap-6 rounded-[32px]">
        <p class="text-white font-medium">¿Tienes alguna otra duda específica?</p>
        <a href="/contacto" class="text-accent font-bold hover:underline underline-offset-4 decoration-2">Contáctanos directamente →</a>
     </div>
  </div>
</Section>

<script>
  function initFAQ() {
    const faqItems = document.querySelectorAll('.faq-item');
    
    faqItems.forEach(item => {
      const trigger = item.querySelector('.faq-trigger');
      const content = item.querySelector('.faq-content') as HTMLElement;
      const icon = item.querySelector('.faq-icon');

      trigger?.addEventListener('click', () => {
        const isOpen = trigger.getAttribute('aria-expanded') === 'true';
        
        // Close all other items for exclusive behavior as requested
        faqItems.forEach(otherItem => {
          if (otherItem !== item) {
            const otherTrigger = otherItem.querySelector('.faq-trigger');
            const otherContent = otherItem.querySelector('.faq-content') as HTMLElement;
            const otherIcon = otherItem.querySelector('.faq-icon');
            
            otherTrigger?.setAttribute('aria-expanded', 'false');
            otherContent.style.maxHeight = '0';
            otherIcon?.classList.remove('rotate-180');
          }
        });

        // Toggle current item
        trigger.setAttribute('aria-expanded', !isOpen ? 'true' : 'false');
        content.style.maxHeight = !isOpen ? `${content.scrollHeight}px` : '0';
        icon?.classList.toggle('rotate-180', !isOpen);
      });
    });
  }

  window.addEventListener('load', initFAQ);
  document.addEventListener('astro:page-load', initFAQ);
</script>
