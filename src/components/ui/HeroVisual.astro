---
import Card from '../molecules/Card.astro';
---

<div class="relative w-full aspect-square flex items-center justify-center">
  <!-- Background Glows -->
  <div class="absolute inset-0 bg-accent/20 blur-[120px] rounded-full scale-75 animate-pulse-slow"></div>
  
  <!-- Central Dashboard Mockup -->
  <div class="relative z-10 w-[90%] h-[75%] glass-panel border-white/10 shadow-2xl p-5 flex flex-col gap-5 bg-white/2">
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-white/5 pb-4">
      <div class="flex gap-2">
        <div class="w-3 h-3 rounded-full bg-white/10"></div>
        <div class="w-3 h-3 rounded-full bg-white/10"></div>
        <div class="w-3 h-3 rounded-full bg-white/10"></div>
      </div>
      <div class="w-40 h-2.5 bg-white/5 rounded-full"></div>
      <div class="w-8 h-8 rounded-full bg-white/5"></div>
    </div>
    
    <!-- Content Grid -->
    <div class="grid grid-cols-12 gap-4 h-full">
      <div class="col-span-3 flex flex-col gap-4">
        <div class="h-10 bg-white/5 rounded-md w-full"></div>
        <div class="h-10 bg-white/5 rounded-md w-4/5"></div>
        <div class="h-10 bg-white/5 rounded-md w-full"></div>
        <div class="mt-auto h-24 bg-accent/10 border border-accent/20 rounded-lg"></div>
      </div>
      <div class="col-span-9 flex flex-col gap-4">
        <div class="grid grid-cols-2 gap-4 h-1/3">
          <div class="bg-white/5 rounded-xl p-3 border border-white/5">
             <div class="w-1/2 h-2 bg-white/10 rounded mb-2"></div>
             <div class="w-full h-4 bg-white/5 rounded"></div>
          </div>
          <div class="bg-white/5 rounded-xl p-3 border border-white/5">
             <div class="w-1/3 h-2 bg-white/10 rounded mb-2"></div>
             <div class="w-full h-4 bg-white/5 rounded"></div>
          </div>
        </div>
        <div class="h-2/3 bg-white/3 rounded-xl border border-white/5 relative overflow-hidden">
          <div class="absolute inset-0 bg-linear-to-br from-accent/5 to-transparent"></div>
          <!-- Tiny graph simulation -->
          <svg class="absolute bottom-0 left-0 w-full h-24" viewBox="0 0 100 20" preserveAspectRatio="none">
            <path d="M0,20 L0,15 Q25,5 50,12 T100,2 L100,20 Z" fill="url(#grad)" opacity="0.2"></path>
            <defs>
              <linearGradient id="grad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" style="stop-color:var(--color-accent);stop-opacity:1" />
                <stop offset="100%" style="stop-color:var(--color-accent);stop-opacity:0" />
              </linearGradient>
            </defs>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Floating Elements -->
  <!-- Card 1: Growth -->
  <Card class="absolute -top-4 -right-8 w-52 h-36 z-20 p-5! flex flex-col justify-between -rotate-3 animate-float-slow backdrop-blur-2xl">
    <div class="flex justify-between items-start">
      <div class="w-10 h-10 rounded-xl bg-accent/20 flex items-center justify-center border border-accent/30">
        <div class="w-5 h-5 bg-accent rounded-sm shadow-glow"></div>
      </div>
      <span class="text-xs text-accent font-bold px-2 py-0.5 rounded-full bg-accent/10">+42%</span>
    </div>
    <div>
      <div class="text-[11px] text-text-secondary uppercase tracking-wider font-bold mb-1">Crecimiento Mensual</div>
      <div class="text-2xl font-bold text-white tracking-tight">Expansión Digital</div>
    </div>
  </Card>

  <!-- Card 2: Automation Status -->
  <Card class="absolute -bottom-8 -left-12 w-64 h-40 z-20 p-5! flex flex-col gap-4 rotate-3 animate-float-slow-delayed backdrop-blur-2xl">
    <div class="flex items-center justify-between">
      <div class="text-sm font-bold text-white">Sistemas Activos</div>
      <div class="flex gap-1">
        <div class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></div>
        <div class="w-1.5 h-1.5 rounded-full bg-accent/30"></div>
      </div>
    </div>
    <div class="flex flex-col gap-3">
      <div class="flex flex-col gap-1.5">
        <div class="flex justify-between text-[10px] text-text-secondary">
          <span>SEO Local</span>
          <span>92%</span>
        </div>
        <div class="h-1.5 w-full bg-white/5 rounded-full overflow-hidden">
          <div class="h-full bg-accent w-[92%] shadow-glow"></div>
        </div>
      </div>
      <div class="flex flex-col gap-1.5">
        <div class="flex justify-between text-[10px] text-text-secondary">
          <span>Lead Gen</span>
          <span>78%</span>
        </div>
        <div class="h-1.5 w-full bg-white/5 rounded-full overflow-hidden">
          <div class="h-full bg-accent-glow w-[78%]"></div>
        </div>
      </div>
    </div>
  </Card>

  <!-- Decorative Connection Lines -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none z-0" viewBox="0 0 400 400">
    <defs>
      <linearGradient id="line-grad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" style="stop-color:var(--color-accent);stop-opacity:0" />
        <stop offset="50%" style="stop-color:var(--color-accent);stop-opacity:0.3" />
        <stop offset="100%" style="stop-color:var(--color-accent);stop-opacity:0" />
      </linearGradient>
    </defs>
    <circle cx="200" cy="200" r="180" fill="none" stroke="url(#line-grad)" stroke-width="0.5" />
    <circle cx="200" cy="200" r="140" fill="none" stroke="url(#line-grad)" stroke-width="0.5" opacity="0.5" />
  </svg>
</div>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(-3deg); }
    50% { transform: translateY(-20px) rotate(-1deg); }
  }
  
  @keyframes float-delayed {
    0%, 100% { transform: translateY(0) rotate(3deg); }
    50% { transform: translateY(20px) rotate(5deg); }
  }

  @keyframes pulse-slow {
    0%, 100% { opacity: 0.15; transform: scale(0.75); }
    50% { opacity: 0.35; transform: scale(1.05); }
  }

  .animate-float-slow {
    animation: float 8s ease-in-out infinite;
  }

  .animate-float-slow-delayed {
    animation: float-delayed 10s ease-in-out infinite 1s;
  }

  .animate-pulse-slow {
    animation: pulse-slow 12s ease-in-out infinite;
  }
</style>
