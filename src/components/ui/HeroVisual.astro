---
import Card from '../molecules/Card.astro';
---

<div class="relative w-full aspect-square flex items-center justify-center scale-90 md:scale-100">
  <!-- Background Glows -->
  <div class="absolute inset-0 bg-brand-cyan/30 dark:bg-brand-blue/20 blur-[100px] md:blur-[120px] rounded-full scale-75 animate-pulse-slow transition-colors"></div>
  
  <!-- Central Dashboard Mockup -->
  <div class="relative z-10 w-[95%] md:w-[90%] h-[75%] bg-light-surface/60 dark:bg-white/2 backdrop-blur-xl border border-light-border/50 dark:border-white/10 shadow-xl dark:shadow-2xl p-4 md:p-5 flex flex-col gap-4 md:gap-5 rounded-2xl transition-colors">
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-light-border/40 dark:border-white/5 pb-3 md:pb-4 transition-colors">
      <div class="flex gap-1.5 md:gap-2">
        <div class="w-2.5 h-2.5 md:w-3 md:h-3 rounded-full bg-black/20 dark:bg-white/10"></div>
        <div class="w-2.5 h-2.5 md:w-3 md:h-3 rounded-full bg-black/15 dark:bg-white/10"></div>
        <div class="w-2.5 h-2.5 md:w-3 md:h-3 rounded-full bg-black/10 dark:bg-white/10"></div>
      </div>
      <div class="w-32 md:w-40 h-2 md:h-2.5 bg-black/5 dark:bg-white/5 rounded-full transition-colors"></div>
      <div class="w-6 h-6 md:w-8 md:h-8 rounded-full bg-black/5 dark:bg-white/5 transition-colors"></div>
    </div>
    
    <!-- Content Grid -->
    <div class="grid grid-cols-12 gap-3 md:gap-4 h-full">
      <div class="col-span-3 flex flex-col gap-3 md:gap-4">
        <div class="h-8 md:h-10 bg-black/5 dark:bg-white/5 rounded-md w-full transition-colors"></div>
        <div class="h-8 md:h-10 bg-black/5 dark:bg-white/5 rounded-md w-4/5 transition-colors"></div>
        <div class="h-8 md:h-10 bg-black/5 dark:bg-white/5 rounded-md w-full transition-colors"></div>
        <div class="mt-auto h-20 md:h-24 bg-brand-blue/5 dark:bg-brand-cyan/10 border border-brand-blue/10 dark:border-brand-cyan/20 rounded-lg transition-colors"></div>
      </div>
      <div class="col-span-9 flex flex-col gap-3 md:gap-4">
        <div class="grid grid-cols-2 gap-3 md:gap-4 h-1/3">
          <div class="bg-light-base/50 dark:bg-white/5 rounded-xl p-2 md:p-3 border border-light-border/30 dark:border-white/5 transition-colors shadow-sm dark:shadow-none">
             <div class="w-1/2 h-1.5 md:h-2 bg-black/10 dark:bg-white/10 rounded mb-2 transition-colors"></div>
             <div class="w-full h-3 md:h-4 bg-black/5 dark:bg-white/5 rounded transition-colors"></div>
          </div>
          <div class="bg-light-base/50 dark:bg-white/5 rounded-xl p-2 md:p-3 border border-light-border/30 dark:border-white/5 transition-colors shadow-sm dark:shadow-none">
             <div class="w-1/3 h-1.5 md:h-2 bg-black/10 dark:bg-white/10 rounded mb-2 transition-colors"></div>
             <div class="w-full h-3 md:h-4 bg-black/5 dark:bg-white/5 rounded transition-colors"></div>
          </div>
        </div>
        <div class="h-2/3 bg-light-base/30 dark:bg-white/3 rounded-xl border border-light-border/30 dark:border-white/5 relative overflow-hidden transition-colors shadow-inner dark:shadow-none">
          <div class="absolute inset-0 bg-linear-to-br from-brand-blue/5 to-transparent dark:from-brand-cyan/5 transition-colors"></div>
          <!-- Tiny graph simulation -->
          <svg class="absolute bottom-0 left-0 w-full h-16 md:h-24" viewBox="0 0 100 20" preserveAspectRatio="none">
            <path d="M0,20 L0,15 Q25,5 50,12 T100,2 L100,20 Z" fill="url(#grad)" opacity="0.3"></path>
            <defs>
              <linearGradient id="grad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#4466ff" stop-opacity="1" />
                <stop offset="100%" stop-color="#4466ff" stop-opacity="0" />
              </linearGradient>
            </defs>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Floating Elements -->
  <!-- Card 1: Growth -->
  <Card class="absolute -top-2 -right-2 md:-top-4 md:-right-8 w-40 md:w-52 h-28 md:h-36 z-20 p-3! md:p-5! flex flex-col justify-between -rotate-3 animate-float-slow backdrop-blur-2xl shadow-lg dark:shadow-2xl">
    <div class="flex justify-between items-start">
      <div class="w-7 h-7 md:w-10 md:h-10 rounded-xl bg-brand-cyan/10 dark:bg-brand-blue/20 flex items-center justify-center border border-brand-cyan/20 dark:border-brand-blue/30 transition-colors">
        <div class="w-3.5 h-3.5 md:w-5 md:h-5 bg-brand-blue dark:bg-brand-cyan rounded-sm shadow-[0_0_10px_rgba(68,102,255,0.4)]"></div>
      </div>
      <span class="text-[9px] md:text-xs text-brand-blue dark:text-brand-cyan font-bold px-2 py-0.5 rounded-full bg-brand-cyan/10 dark:bg-brand-blue/10 transition-colors">+42%</span>
    </div>
    <div>
      <div class="text-[8px] md:text-[11px] text-text-dark dark:text-text-secondary uppercase tracking-wider font-bold mb-0.5 md:mb-1 transition-colors">Crecimiento Mensual</div>
      <div class="text-lg md:text-2xl font-bold text-text-dark-titles dark:text-white tracking-tight transition-colors">Expansión</div>
    </div>
  </Card>

  <!-- Card 2: Automation Status -->
  <Card class="absolute -bottom-4 -left-2 md:-bottom-8 md:-left-12 w-48 md:w-64 h-32 md:h-40 z-20 p-3! md:p-5! flex flex-col gap-2 md:gap-4 rotate-3 animate-float-slow-delayed backdrop-blur-2xl shadow-lg dark:shadow-2xl">
    <div class="flex items-center justify-between">
      <div class="text-[10px] md:text-sm font-bold text-text-dark-titles dark:text-white transition-colors">Sistemas Activos</div>
      <div class="flex gap-1">
        <div class="w-1.5 h-1.5 rounded-full bg-brand-blue dark:bg-brand-cyan animate-pulse"></div>
        <div class="w-1.5 h-1.5 rounded-full bg-brand-blue/30 dark:bg-brand-cyan/30 transition-colors"></div>
      </div>
    </div>
    <div class="flex flex-col gap-1.5 md:gap-3">
      <div class="flex flex-col gap-0.5 md:gap-1.5">
        <div class="flex justify-between text-[8px] md:text-[10px] text-text-dark dark:text-text-secondary transition-colors">
          <span>SEO Local</span>
          <span>92%</span>
        </div>
        <div class="h-1 md:h-1.5 w-full bg-black/5 dark:bg-white/5 rounded-full overflow-hidden transition-colors">
          <div class="h-full bg-brand-blue dark:bg-brand-cyan w-[92%] shadow-[0_0_8px_rgba(68,102,255,0.5)] transition-colors"></div>
        </div>
      </div>
      <div class="flex flex-col gap-0.5 md:gap-1.5">
        <div class="flex justify-between text-[8px] md:text-[10px] text-text-dark dark:text-text-secondary transition-colors">
          <span>Lead Gen</span>
          <span>78%</span>
        </div>
        <div class="h-1 md:h-1.5 w-full bg-black/5 dark:bg-white/5 rounded-full overflow-hidden transition-colors">
          <div class="h-full bg-brand-purple dark:bg-brand-blue w-[78%] transition-colors"></div>
        </div>
      </div>
    </div>
  </Card>

  <!-- Decorative Connection Lines -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none z-0" viewBox="0 0 400 400">
    <defs>
      <linearGradient id="line-grad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#4466ff" stop-opacity="0" />
        <stop offset="50%" stop-color="#4466ff" stop-opacity="0.4" />
        <stop offset="100%" stop-color="#4466ff" stop-opacity="0" />
      </linearGradient>
    </defs>
    <circle cx="200" cy="200" r="180" fill="none" stroke="url(#line-grad)" stroke-width="0.5" />
    <circle cx="200" cy="200" r="140" fill="none" stroke="url(#line-grad)" stroke-width="0.5" opacity="0.5" />
  </svg>
</div>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(-3deg); }
    50% { transform: translateY(-15px) rotate(-1deg); }
  }
  
  @keyframes float-delayed {
    0%, 100% { transform: translateY(0) rotate(3deg); }
    50% { transform: translateY(15px) rotate(5deg); }
  }

  @keyframes pulse-slow {
    0%, 100% { opacity: 0.2; transform: scale(0.85); }
    50% { opacity: 0.5; transform: scale(1.08); }
  }

  .animate-float-slow {
    animation: float 5s ease-in-out infinite;
  }

  .animate-float-slow-delayed {
    animation: float-delayed 7s ease-in-out infinite 1s;
  }

  .animate-pulse-slow {
    animation: pulse-slow 8s ease-in-out infinite;
  }
</style>
