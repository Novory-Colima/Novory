---
import Button from "../atoms/Button.astro";
import ToggleTheme from "../atoms/ToggleTheme.astro";

const navLinks = [
  { name: "Inicio", href: "/" },
  { name: "Servicios", href: "/servicios" },
  { name: "Portafolio", href: "/portafolio" },
  { name: "Blog", href: "/blog" },
  { name: "Nosotros", href: "/nosotros" },
  { name: "Contacto", href: "/contacto" },
];
---

<nav
  id="navbar"
  class="fixed top-0 left-0 w-full z-40 transition-all duration-500 py-6"
>
  <div class="container-novory flex items-center justify-between">
    <a href="/" class="group relative">
      <img
        src="/assets/novory-logotipo-horizontal-color-clear-svg.svg"
        alt="Logo Novory"
        class="w-24 sm:w-28 md:w-32 transition-transform duration-300 group-hover:scale-105 dark:hidden"
      />
      <img
        src="/assets/novory-logotipo-horizontal-color-dark-svg.svg"
        alt="Logo Novory"
        class="w-24 sm:w-28 md:w-32 transition-transform duration-300 group-hover:scale-105 hidden dark:block"
      />
    </a>
    
    <div class="hidden md:flex items-center gap-8">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-text-dark dark:text-text-light hover:text-brand-blue dark:hover:text-white transition-colors relative group"
          >
            {link.name}
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-brand-blue dark:bg-brand-cyan transition-all duration-300 group-hover:w-full rounded-full"></span>
          </a>
        ))
      }
    </div>

    <div class="hidden md:flex items-center gap-4">
      <ToggleTheme />
      <Button variant="primary" size="sm" href="/contacto">
        Agenda una asesoría
      </Button>
    </div>

    <button
      id="menu-toggle"
      class="md:hidden text-text-dark dark:text-white p-2 cursor-pointer transition-transform hover:scale-110 focus:outline-none"
      aria-label="Abrir menú"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <div
      id="mobile-menu"
      class="fixed inset-0 bg-light-base/98 dark:bg-dark-base/98 backdrop-blur-2xl z-50 translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.4,0.0,0.2,1)] md:hidden flex flex-col"
    >
      <div class="flex items-center justify-between p-6 sm:p-8 border-b border-light-border/50 dark:border-dark-border/50">
        <img
          src="/assets/novory-logotipo-horizontal-color-clear-svg.svg"
          alt="Logo Novory"
          class="w-24 dark:hidden"
        />
        <img
          src="/assets/novory-logotipo-horizontal-color-dark-svg.svg"
          alt="Logo Novory"
          class="w-24 hidden dark:block"
        />
        
        <button
          id="menu-close"
          class="text-text-dark dark:text-white p-2 cursor-pointer transition-transform hover:rotate-90 focus:outline-none"
          aria-label="Cerrar menú"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <div class="flex flex-col gap-6 p-8 overflow-y-auto grow">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="text-3xl font-bold text-text-dark-titles dark:text-white hover:text-brand-blue dark:hover:text-brand-cyan transition-colors"
            >
              {link.name}
            </a>
          ))
        }
      </div>

      <div class="p-8 border-t border-light-border/50 dark:border-dark-border/50 flex flex-col gap-6 pb-12">
        <div class="flex items-center justify-between">
          <span class="text-sm font-medium text-text-dark dark:text-text-light">Apariencia</span>
          <ToggleTheme />
        </div>
        <Button variant="primary" size="lg" class="w-full text-center flex justify-center" href="/contacto">
          Agenda una asesoría
        </Button>
      </div>
    </div>
  </div>

  <script>
    function initNavbar() {
      const navbar = document.getElementById("navbar");
      const menuToggle = document.getElementById("menu-toggle");
      const menuClose = document.getElementById("menu-close");
      const mobileMenu = document.getElementById("mobile-menu");

      const handleScroll = () => {
        if (window.scrollY > 50) {
          navbar?.classList.add(
            "bg-light-base/70",
            "dark:bg-dark-base/70",
            "backdrop-blur-xl",
            "border-b",
            "border-light-border/50",
            "dark:border-dark-border/50",
            "py-4",
            "shadow-sm"
          );
          navbar?.classList.remove("py-6");
        } else {
          navbar?.classList.remove(
            "bg-light-base/70",
            "dark:bg-dark-base/70",
            "backdrop-blur-xl",
            "border-b",
            "border-light-border/50",
            "dark:border-dark-border/50",
            "py-4",
            "shadow-sm"
          );
          navbar?.classList.add("py-6");
        }
      };

      // Run scroll check initially
      handleScroll();

      // Bind events
      window.addEventListener("scroll", handleScroll);

      const openMenu = () => {
        mobileMenu?.classList.remove("translate-x-full");
        mobileMenu?.classList.add("translate-x-0");
        document.body.style.overflow = "hidden";
      };

      const closeMenu = () => {
        mobileMenu?.classList.remove("translate-x-0");
        mobileMenu?.classList.add("translate-x-full");
        document.body.style.overflow = "";
      };

      menuToggle?.addEventListener("click", openMenu);
      menuClose?.addEventListener("click", closeMenu);

      // Clean up global window listener on page transition
      document.addEventListener("astro:before-swap", () => {
        window.removeEventListener("scroll", handleScroll);
        document.body.style.overflow = "";
      }, { once: true });
    }

    document.addEventListener("astro:page-load", initNavbar);
  </script>
</nav>
