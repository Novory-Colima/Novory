---
import Button from "../atoms/Button.astro";
import ToggleTheme from "../atoms/ToggleTheme.astro";
import { withBase } from "../../utils/navigation";
import { WHATSAPP_URLS } from "../../utils/whatsapp";

const pathname = Astro.url.pathname;

const navLinks = [
  { name: "Inicio", href: withBase('/') },
  { name: "Servicios", href: withBase('/servicios') },
  { name: "Nosotros", href: withBase('/nosotros') },
  { name: "Contacto", href: withBase('/contacto') },
];

const isActive = (href: string) => {
  const current = pathname.endsWith('/') && pathname !== '/' ? pathname.slice(0, -1) : pathname;
  const target = href.endsWith('/') && href !== '/' ? href.slice(0, -1) : href;

  if (target === '/' || target === withBase('/')) {
    return current === '/' || current === withBase('/') || current === '';
  }
  return current === target || current.startsWith(`${target}/`);
};
---

<nav
  id="navbar"
  class="fixed top-0 left-0 w-full z-40 transition-all duration-500 py-6"
>
  <div class="container-novory flex items-center justify-between">
    <a href={withBase('/')} class="group relative">
      <img
        src={withBase('/assets/novory-logotipo-horizontal-color-clear-svg.svg')}
        alt="Logo Novory"
        class="w-24 sm:w-28 md:w-32 transition-transform duration-300 group-hover:scale-105 dark:hidden"
      />
      <img
        src={withBase('/assets/novory-logotipo-horizontal-color-dark-svg.svg')}
        alt="Logo Novory"
        class="w-24 sm:w-28 md:w-32 transition-transform duration-300 group-hover:scale-105 hidden dark:block"
      />
    </a>

    <div class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => {
        const active = isActive(link.href);
        return (
          <a
            href={link.href}
            class:list={[
              "text-sm font-medium transition-colors relative group",
              active
                ? "text-brand-blue dark:text-brand-cyan font-semibold"
                : "text-text-dark dark:text-text-light hover:text-brand-blue dark:hover:text-white"
            ]}
          >
            {link.name}
            <span
              class:list={[
                "absolute -bottom-1 left-0 h-0.5 bg-brand-blue dark:bg-brand-cyan transition-all duration-300 rounded-full",
                active ? "w-full" : "w-0 group-hover:w-full"
              ]}
            ></span>
          </a>
        );
      })}
    </div>

    <div class="hidden md:flex items-center gap-4">
      <ToggleTheme />
      <Button variant="primary" size="sm" href={WHATSAPP_URLS.advisory} target="_blank" rel="noopener noreferrer">
        Agenda una asesoría
      </Button>
    </div>

    <button
      id="menu-toggle"
      class="md:hidden text-text-dark dark:text-white p-2 cursor-pointer transition-transform hover:scale-110 focus:outline-none"
      aria-label="Abrir menú"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>
</nav>

<!-- Mobile menu — outside <nav> to avoid backdrop-filter containing-block issues -->
<div
  id="mobile-menu"
  class="mobile-menu-panel fixed inset-0 z-50 translate-x-full invisible pointer-events-none transition-all duration-500 ease-[cubic-bezier(0.4,0.0,0.2,1)] md:hidden flex flex-col max-w-full overflow-hidden"
  aria-hidden="true"
>
  <!-- Solid opaque background — light and dark -->
  <div class="absolute inset-0 bg-white dark:bg-black"></div>

  <div class="relative z-10 flex flex-col h-full">
    <!-- Header -->
    <div class="flex items-center justify-between p-6 sm:p-8 border-b border-light-border/50 dark:border-dark-border/50">
      <img
        src={withBase('/assets/novory-logotipo-horizontal-color-clear-svg.svg')}
        alt="Logo Novory"
        class="w-24 dark:hidden"
      />
      <img
        src={withBase('/assets/novory-logotipo-horizontal-color-dark-svg.svg')}
        alt="Logo Novory"
        class="w-24 hidden dark:block"
      />

      <button
        id="menu-close"
        class="text-text-dark dark:text-white p-2 cursor-pointer transition-transform hover:rotate-90 focus:outline-none"
        aria-label="Cerrar menú"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Links -->
    <div class="flex flex-col gap-2 p-6 sm:p-8 overflow-y-auto grow">
      {navLinks.map((link) => {
        const active = isActive(link.href);
        return (
          <a
            href={link.href}
            class:list={[
              "mobile-nav-link text-3xl sm:text-4xl font-bold transition-colors py-3 border-b border-light-border/30 dark:border-dark-border/30 last:border-0",
              active
                ? "text-brand-blue dark:text-brand-cyan"
                : "text-text-dark-titles dark:text-white hover:text-brand-blue dark:hover:text-brand-cyan"
            ]}
          >
            {link.name}
          </a>
        );
      })}
    </div>

    <!-- Footer -->
    <div class="p-6 sm:p-8 border-t border-light-border/50 dark:border-dark-border/50 flex flex-col gap-5 pb-10">
      <div class="flex items-center justify-between">
        <span class="text-sm font-medium text-text-dark dark:text-text-light">Apariencia</span>
        <ToggleTheme />
      </div>
      <Button variant="primary" size="lg" class="w-full text-center flex justify-center" href={WHATSAPP_URLS.advisory} target="_blank" rel="noopener noreferrer">
        Agenda una asesoría
      </Button>
    </div>
  </div>
</div>

<script>
  function initNavbar() {
    const navbar = document.getElementById("navbar");
    const menuToggle = document.getElementById("menu-toggle");
    const menuClose = document.getElementById("menu-close");
    const mobileMenu = document.getElementById("mobile-menu");

    if (!mobileMenu) return;

    let scrollTicking = false;

    const updateNavbar = () => {
      const scrolled = window.scrollY > 50;
      if (scrolled) {
        navbar?.classList.add("navbar-scrolled", "backdrop-blur-xl", "border-b", "py-4", "shadow-sm");
        navbar?.classList.remove("py-6");
      } else {
        navbar?.classList.remove("navbar-scrolled", "backdrop-blur-xl", "border-b", "py-4", "shadow-sm");
        navbar?.classList.add("py-6");
      }
      scrollTicking = false;
    };

    const handleScroll = () => {
      if (!scrollTicking) {
        requestAnimationFrame(updateNavbar);
        scrollTicking = true;
      }
    };

    updateNavbar();
    window.addEventListener("scroll", handleScroll, { passive: true });

    const openMenu = () => {
      mobileMenu.classList.remove("translate-x-full", "invisible", "pointer-events-none");
      mobileMenu.classList.add("translate-x-0");
      mobileMenu.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    };

    const closeMenu = () => {
      mobileMenu.classList.remove("translate-x-0");
      mobileMenu.classList.add("translate-x-full", "invisible", "pointer-events-none");
      mobileMenu.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    };

    menuToggle?.addEventListener("click", openMenu);
    menuClose?.addEventListener("click", closeMenu);

    // Close menu when any nav link is clicked
    mobileMenu.querySelectorAll(".mobile-nav-link, a[href]").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("astro:before-swap", () => {
      window.removeEventListener("scroll", handleScroll);
      scrollTicking = false;
      document.body.style.overflow = "";
    }, { once: true });
  }

  document.addEventListener("astro:page-load", initNavbar);
</script>
