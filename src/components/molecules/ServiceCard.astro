---
import { Check, ArrowRight } from "@lucide/astro";

interface Props {
  title: string;
  description: string;
  benefits: string[];
  ctaText: string;
  ctaHref: string;
  class?: string;
}

const { title, description, benefits, ctaText, ctaHref, class: className } =
  Astro.props;
---

<div
  class:list={[
    "service-card group relative overflow-hidden bg-light-surface/60 dark:bg-white/5 backdrop-blur-xl border border-light-border/50 dark:border-white/10 shadow-lg dark:shadow-2xl rounded-2xl p-5 md:p-6 flex flex-col gap-3 md:gap-4 transition-all duration-500 hover:border-brand-blue/30 dark:hover:border-brand-cyan/30 hover:shadow-brand-blue/10 dark:hover:shadow-brand-cyan/10 hover:-translate-y-1 aspect-[3/4] sm:aspect-[4/5]",
    className,
  ]}
>
  <!-- Fondo con glassmorphism premium que se activa al hacer hover -->
  <div class="hover-bg absolute inset-0 bg-linear-to-br from-brand-blue/10 via-transparent to-brand-cyan/10 dark:from-brand-blue/15 dark:via-transparent dark:to-brand-cyan/15 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

  <!-- Área visual (representación del servicio) - Siempre visible -->
  <div
    class="service-card-visual relative aspect-[16/9] w-full rounded-xl bg-linear-to-br from-brand-blue/8 via-brand-blue/5 to-brand-cyan/8 dark:from-brand-blue/15 dark:via-brand-blue/8 dark:to-brand-cyan/12 border border-brand-blue/10 dark:border-white/8 overflow-hidden shrink-0 text-brand-blue dark:text-brand-cyan z-10 transition-transform duration-500 group-hover:scale-[1.02] group-hover:shadow-md"
  >
    <slot name="visual" />
  </div>

  <!-- Contenedor relativo para hacer crossfade entre Front y Back text -->
  <div class="relative grow flex flex-col z-10">
    
    <!-- Cara Frontal (Texto) -->
    <div class="front-content flex flex-col gap-1.5 md:gap-2 h-full transition-all duration-500 opacity-100 group-hover:opacity-0 group-hover:-translate-y-4 pointer-events-auto group-hover:pointer-events-none">
      <h3
        class="text-xl md:text-2xl font-bold text-text-dark-titles dark:text-text-light-titles tracking-tight leading-tight"
      >
        {title}
      </h3>
      <p
        class="text-text-dark-muted dark:text-text-light-muted text-xs md:text-sm leading-relaxed"
      >
        {description}
      </p>

      <span
        class="inline-flex items-center gap-2 text-[10px] md:text-xs font-black text-brand-blue dark:text-brand-cyan uppercase tracking-[0.15em] mt-auto pt-2"
      >
        Ver beneficios
        <ArrowRight class="w-3 h-3 md:w-3.5 md:h-3.5 group-hover:translate-x-1 transition-transform duration-500" />
      </span>
    </div>

    <!-- Cara Trasera (Beneficios) -->
    <div class="back-content absolute inset-0 flex flex-col h-full transition-all duration-500 opacity-0 translate-y-4 group-hover:translate-y-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto">
      <ul class="flex flex-col gap-2.5 md:gap-3 grow mb-4">
        {
          benefits.map((benefit) => (
            <li class="flex items-start gap-2.5 text-xs md:text-sm font-medium leading-snug text-text-dark-titles dark:text-white">
              <span class="w-5 h-5 rounded-full bg-brand-blue/10 dark:bg-brand-cyan/10 border border-brand-blue/20 dark:border-brand-cyan/20 flex items-center justify-center shrink-0 mt-0.5 text-brand-blue dark:text-brand-cyan">
                <Check class="w-3 h-3" stroke-width="3" />
              </span>
              <span>{benefit}</span>
            </li>
          ))
        }
      </ul>
      <a
        href={ctaHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 w-full bg-brand-blue dark:bg-brand-cyan text-white dark:text-dark-base font-bold text-xs md:text-sm rounded-lg px-4 py-2.5 md:py-3 shadow-md hover:shadow-lg hover:shadow-brand-blue/30 dark:hover:shadow-brand-cyan/30 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300 mt-auto"
      >
        {ctaText}
        <span>→</span>
      </a>
    </div>

  </div>
</div>

<style>
  /* Mobile fallback using classes since we removed 3D rotate */
  .service-card.is-flipped .front-content {
    opacity: 0;
    transform: translateY(-1rem);
    pointer-events: none;
  }
  .service-card.is-flipped .back-content {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .service-card.is-flipped .hover-bg {
    opacity: 1;
  }
  .service-card.is-flipped .service-card-visual {
    transform: scale(1.02);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }
</style>
