---
import { Check, RotateCw } from "@lucide/astro";

interface Props {
  title: string;
  description: string;
  benefits: string[];
  ctaText: string;
  ctaHref: string;
  class?: string;
}

const { title, description, benefits, ctaText, ctaHref, class: className } =
  Astro.props;
---

<div
  class:list={[
    "service-card group opacity-0 aspect-[3/4] sm:aspect-[4/5]",
    className,
  ]}
>
  <div class="service-card-inner">
    <!-- Cara frontal -->
    <div
      class="service-card-face service-card-front bg-light-surface/60 dark:bg-white/5 backdrop-blur-xl border border-light-border/50 dark:border-white/10 shadow-lg dark:shadow-2xl rounded-[20px] p-5 md:p-6 flex flex-col gap-3 md:gap-4"
    >
      <!-- Área visual (representación del servicio) -->
      <div
        class="service-card-visual relative aspect-[16/9] w-full rounded-xl bg-linear-to-br from-brand-blue/8 via-brand-blue/5 to-brand-cyan/8 dark:from-brand-blue/15 dark:via-brand-blue/8 dark:to-brand-cyan/12 border border-brand-blue/10 dark:border-white/8 overflow-hidden shrink-0 text-brand-blue dark:text-brand-cyan"
      >
        <slot name="visual" />
      </div>

      <div class="flex flex-col gap-1.5 md:gap-2 grow min-h-0">
        <h3
          class="text-xl md:text-2xl font-bold text-text-dark-titles dark:text-text-light-titles tracking-tight leading-tight"
        >
          {title}
        </h3>
        <p
          class="text-text-dark-muted dark:text-text-light-muted text-xs md:text-sm leading-relaxed"
        >
          {description}
        </p>
      </div>

      <span
        class="inline-flex items-center gap-2 text-[10px] md:text-xs font-black text-brand-blue dark:text-brand-cyan uppercase tracking-[0.15em]"
      >
        Ver beneficios
        <RotateCw
          class="w-3 h-3 md:w-3.5 md:h-3.5 group-hover:rotate-180 transition-transform duration-500"
        />
      </span>
    </div>

    <!-- Cara trasera -->
    <div
      class="service-card-face service-card-back bg-linear-to-br from-brand-blue via-brand-blue to-brand-purple rounded-[20px] p-5 md:p-6 flex flex-col gap-3 md:gap-4 text-white shadow-xl"
    >
      <h3 class="text-lg md:text-xl font-bold tracking-tight">{title}</h3>
      <ul class="flex flex-col gap-2.5 md:gap-3 grow">
        {
          benefits.map((benefit) => (
            <li class="flex items-start gap-2.5 text-xs md:text-sm font-medium leading-snug">
              <span class="w-5 h-5 rounded-full bg-white/20 flex items-center justify-center shrink-0 mt-0.5">
                <Check class="w-3 h-3" />
              </span>
              <span>{benefit}</span>
            </li>
          ))
        }
      </ul>
      <a
        href={ctaHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 w-full bg-white text-brand-blue font-bold text-xs md:text-sm rounded-lg px-4 py-2.5 md:py-3 hover:bg-white/90 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300"
      >
        {ctaText}
        <span>→</span>
      </a>
    </div>
  </div>
</div>

<style>
  .service-card {
    perspective: 1200px;
  }

  .service-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .service-card-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .service-card-back {
    transform: rotateY(180deg);
  }

  .service-card.is-flipped .service-card-inner {
    transform: rotateY(180deg);
  }

  @media (hover: hover) and (pointer: fine) {
    .service-card:hover .service-card-inner {
      transform: rotateY(180deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card-inner {
      transition: none;
    }
  }
</style>
