---
import Button from '../atoms/Button.astro';
import Badge from '../atoms/Badge.astro';

interface Props {
  title: string;
  problem: string;
  solution: string;
  result: string;
  technologies: string[];
  image?: string;
  side?: 'left' | 'right';
  href: string;
}

const { title, problem, solution, result, technologies, image, side = 'right', href } = Astro.props;
---

<div class:list={['grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24 items-center py-16 md:py-24 opacity-0 portfolio-reveal translate-y-16', side === 'left' ? '' : '']}>
  
  <!-- Image/Visual -->
  <div class:list={['lg:col-span-7 relative group', side === 'left' ? 'lg:order-2' : 'lg:order-1']}>
    <div class="aspect-[16/10] md:aspect-[16/9] rounded-[30px] md:rounded-[40px] overflow-hidden bg-light-surface dark:bg-white/[0.03] border border-light-border/50 dark:border-white/10 shadow-xl dark:shadow-2xl relative transition-colors">
       
       <!-- Placeholder visual (Si hay imagen, deberías usar <img src={image} /> aquí) -->
       <div class="absolute inset-0 bg-brand-blue/5 flex items-center justify-center text-brand-blue/20">
          <svg class="w-24 h-24 md:w-32 md:h-32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.3" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
       </div>
       
       <!-- Hover Overlay animado -->
       <div class="absolute inset-0 bg-brand-blue/10 dark:bg-brand-blue/20 opacity-0 group-hover:opacity-100 transition-opacity duration-700 backdrop-blur-[1px] md:backdrop-blur-[2px]"></div>
       
       <!-- Título sobre la imagen (Gradiente que adapta al tema) -->
       <div class="absolute inset-x-0 bottom-0 p-6 md:p-8 lg:p-12 bg-gradient-to-t from-light-base via-light-base/60 dark:from-dark-base dark:via-dark-base/40 to-transparent">
          <h3 class="text-text-dark-titles dark:text-white text-3xl md:text-4xl lg:text-5xl font-bold tracking-tighter transition-colors">{title}</h3>
       </div>
    </div>
    
    <!-- Floating "Result" Badge (Modo claro = fondo blanco, Oscuro = fondo negro) -->
    <div class="absolute -top-4 -right-4 md:-top-6 md:-right-6 lg:top-12 lg:-right-12 p-6 md:p-8 rounded-[var(--radius-xl)] bg-light-base/90 dark:bg-dark-base/90 backdrop-blur-2xl border border-brand-blue/20 dark:border-brand-cyan/40 shadow-[0_8px_30px_rgba(0,0,0,0.1)] dark:shadow-glow rotate-3 md:rotate-6 group-hover:rotate-0 group-hover:scale-105 md:group-hover:scale-110 transition-all duration-700 ease-[cubic-bezier(0.4,0.0,0.2,1)] z-30">
       <div class="text-[10px] md:text-[11px] text-brand-blue dark:text-brand-cyan uppercase tracking-[0.2em] font-black mb-1 md:mb-2">Transformación</div>
       <div class="text-2xl md:text-3xl font-bold text-text-dark-titles dark:text-white tracking-tight transition-colors">{result}</div>
    </div>
  </div>

  <!-- Content -->
  <div class:list={['lg:col-span-5 flex flex-col gap-8 md:gap-10 mt-8 lg:mt-0', side === 'left' ? 'lg:order-1' : 'lg:order-2']}>
    
    <!-- Etiqueta de sección -->
    <div class="flex items-center gap-3">
        <div class="w-8 h-[2px] bg-brand-blue dark:bg-brand-cyan"></div>
        <span class="text-brand-blue dark:text-brand-cyan font-bold text-xs md:text-sm tracking-[0.3em] uppercase">Caso de Éxito</span>
    </div>

    <!-- Problema y Solución -->
    <div class="flex flex-col gap-8 md:gap-10">
      <div class="flex flex-col gap-2 md:gap-3">
        <span class="text-[10px] md:text-[11px] text-text-dark-muted/60 dark:text-white/30 font-black uppercase tracking-[0.2em] transition-colors">El Problema</span>
        <p class="text-text-dark-muted dark:text-text-light text-lg md:text-xl leading-relaxed font-medium italic transition-colors">"{problem}"</p>
      </div>
      
      <div class="flex flex-col gap-2 md:gap-3">
        <span class="text-[10px] md:text-[11px] text-text-dark-muted/60 dark:text-white/30 font-black uppercase tracking-[0.2em] transition-colors">Nuestra Solución</span>
        <p class="text-text-dark-titles dark:text-white text-lg md:text-xl leading-relaxed transition-colors">{solution}</p>
      </div>
    </div>

    <!-- Tecnologías -->
    <div class="flex flex-wrap gap-2 md:gap-2.5">
      {technologies.map((tech) => (
        <Badge class="uppercase tracking-widest font-bold">
          {tech}
        </Badge>
      ))}
    </div>

    <!-- CTA -->
    <div class="pt-2 md:pt-4">
      <Button variant="primary" size="lg" href={href} class="group/btn !rounded-full w-full sm:w-auto">
        <span class="mr-3 font-black uppercase tracking-widest text-xs md:text-sm">Ver caso completo</span>
        <span class="group-hover/btn:translate-x-2 transition-transform duration-300">→</span>
      </Button>
    </div>
  </div>
</div>