---
import Section from '../layout/Section.astro';
import Button from '../atoms/Button.astro';
import { Check } from '@lucide/astro';

interface Props {
  title: string;
  description: string;
  benefits: string[];
  ctaText: string;
  ctaHref: string;
  imageSide?: 'left' | 'right';
  class?: string;
}

const { 
  title, 
  description, 
  benefits, 
  ctaText, 
  ctaHref, 
  imageSide = 'right',
  class: className 
} = Astro.props;
---

<div class:list={['grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center py-20 opacity-0 service-block-reveal', className]}>
  <div class:list={['flex flex-col gap-8', imageSide === 'left' ? 'lg:order-2' : 'lg:order-1']}>
    <h3 class="text-4xl md:text-5xl font-bold text-white tracking-tight leading-tight">{title}</h3>
    <p class="text-text-secondary text-lg md:text-xl leading-relaxed">
      {description}
    </p>
    
    <ul class="flex flex-col gap-4">
      {benefits.map((benefit) => (
        <li class="flex items-center gap-4 text-white group/item">
          <div class="w-6 h-6 rounded-full bg-accent/20 flex items-center justify-center text-accent group-hover/item:bg-accent group-hover/item:text-white transition-colors duration-300">
            <Check class="w-3.5 h-3.5" />
          </div>
          <span class="text-base md:text-lg font-medium">{benefit}</span>
        </li>
      ))}
    </ul>

    <div class="mt-4">
      <Button variant="secondary" size="lg" href={ctaHref} class="group/btn">
        <span class="mr-2">{ctaText}</span>
        <span class="group-hover/btn:translate-x-1 transition-transform">→</span>
      </Button>
    </div>
  </div>

  <div class:list={['relative aspect-[16/10] rounded-3xl overflow-hidden glass-panel border-white/10 bg-white/[0.02] flex items-center justify-center group/visual', imageSide === 'left' ? 'lg:order-1' : 'lg:order-2']}>
    <!-- Slot for specific visual -->
    <div class="w-full h-full p-6 md:p-10 flex items-center justify-center relative">
       <slot name="visual" />
    </div>
    
    <!-- Decorative background glow -->
    <div class="absolute inset-0 bg-accent/5 blur-[120px] -z-10 group-hover/visual:bg-accent/15 transition-all duration-1000"></div>
  </div>
</div>
