---
import Button from '../atoms/Button.astro';
import { Check } from '@lucide/astro';

interface Props {
  title: string;
  description: string;
  benefits: string[];
  ctaText: string;
  ctaHref: string;
  imageSide?: 'left' | 'right';
  class?: string;
}

const { 
  title, 
  description, 
  benefits, 
  ctaText, 
  ctaHref, 
  imageSide = 'right',
  class: className 
} = Astro.props;
---

<div class:list={['grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-24 items-center py-16 md:py-20 opacity-0 service-block-reveal', className]}>
  
  <!-- Contenido de texto -->
  <div class:list={['flex flex-col gap-6 md:gap-8', imageSide === 'left' ? 'lg:order-2' : 'lg:order-1']}>
    <h3 class="text-3xl md:text-4xl lg:text-5xl font-bold text-text-dark-titles dark:text-text-light-titles tracking-tight leading-tight transition-colors">
      {title}
    </h3>
    <p class="text-text-dark-muted dark:text-text-light-muted text-base md:text-lg lg:text-xl leading-relaxed transition-colors">
      {description}
    </p>
    
    <ul class="flex flex-col gap-3 md:gap-4 mt-2">
      {benefits.map((benefit) => (
        <li class="flex items-center gap-3 md:gap-4 text-text-dark dark:text-text-light group/item transition-colors">
          <div class="w-6 h-6 shrink-0 rounded-full bg-brand-cyan/20 dark:bg-brand-blue/20 flex items-center justify-center text-brand-blue dark:text-brand-cyan group-hover/item:bg-brand-blue group-hover/item:text-white transition-colors duration-300">
            <Check class="w-3.5 h-3.5" />
          </div>
          <span class="text-sm md:text-base lg:text-lg font-medium">{benefit}</span>
        </li>
      ))}
    </ul>

    <div class="mt-6">
      <Button variant="secondary" size="lg" href={ctaHref} class="group/btn">
        <span class="mr-2">{ctaText}</span>
        <span class="group-hover/btn:translate-x-1.5 transition-transform duration-300">→</span>
      </Button>
    </div>
  </div>

  <!-- Visual (Glassmorphism adaptativo) -->
  <div class:list={[
    'relative aspect-[4/3] lg:aspect-[16/10] rounded-[var(--radius-xl)] overflow-hidden group/visual transition-all',
    'bg-light-surface/30 dark:bg-white/[0.02] backdrop-blur-xl border border-light-border/40 dark:border-white/10',
    'flex items-center justify-center', 
    imageSide === 'left' ? 'lg:order-1' : 'lg:order-2'
  ]}>
    <div class="w-full h-full p-6 md:p-10 flex items-center justify-center relative z-10">
       <slot name="visual" />
    </div>
    
    <!-- Decorative background glow (Suave en modo claro, brillante en oscuro) -->
    <div class="absolute inset-0 bg-brand-blue/5 dark:bg-brand-blue/10 blur-[80px] md:blur-[120px] -z-10 group-hover/visual:bg-brand-blue/15 dark:group-hover/visual:bg-brand-cyan/20 transition-all duration-1000 ease-[cubic-bezier(0.4,0.0,0.2,1)]"></div>
  </div>
</div>